{
	"name": "svelte-app",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"description": "The SvelteKit starter for hmziq sites: the theme, the brand kit through $brand, a landing page built from the site blocks and a 404 page. Start new projects with `pnpm new-project svelte <folder>`.",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
	},
	"devDependencies": {
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@fontsource-variable/onest": "^5.3.1",
		"@hmziq/brand-core": "workspace:*",
		"@lucide/svelte": "^1.49.0",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^24.13.6",
		"bits-ui": "^2.18.0",
		"cn": "^0.4.0",
		"mdsvex": "^0.12.8",
		"mode-watcher": "^1.1.0",
		"remark-gfm": "^4.0.1",
		"shadcn-svelte": "^1.7.0",
		"simple-icons": "16.32.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"svelte-sonner": "^1.2.1",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "~6.0.2",
		"vite": "^8.0.16"
	},
	"dependencies": {
		"@tanstack/table-core": "^8.21.3",
		"zod": "^4.6.5"
	}
}
