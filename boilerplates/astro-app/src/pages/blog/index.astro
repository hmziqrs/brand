---
// The blog index inside a product site: the page intro, search and topic
// chips, then the posts with the newest featured. The posts are example
// copy, written in Markdown under src/content/blog.
import { getCollection } from "astro:content";
import Site from "../../layouts/Site.astro";
import BlogIndex from "$brand/blocks/content/blog-index.astro";
import { topicTone, topics } from "../../lib/example";

const posts = (await getCollection("blog"))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .map((p) => ({ title: p.data.title, summary: p.data.summary, date: p.data.date, readingTime: p.data.readingTime, updated: p.data.updated, topic: p.data.topic, art: p.data.art, href: `/blog/${p.id}` }));
---

<Site head={{ site: "blog", title: "Blog — astro-app", description: "Example posts, written in Markdown through the kit's blocks.", url: "https://example.com/blog" }}>
  <BlogIndex posts={posts} topics={topics} tone={topicTone}>
    <Fragment slot="title">The <span class="whitespace-nowrap">example</span> blog</Fragment>
    <Fragment slot="lede">Build notes, deep dives and the occasional rant. New posts whenever there's something worth saying. Example copy.</Fragment>
  </BlogIndex>
</Site>
