---
// A blog post, in PostArticle's layout: the wide PostHeader with the post's
// drawing, the contents rail beside the reading column, the share bar, the
// byline and the related posts as picture cards. PostArticle takes
// structured sections, so the body here is the Markdown Astro rendered,
// set through Prose in the same column.
import { getCollection, render } from "astro:content";
import Site from "../../layouts/Site.astro";
import Container from "$brand/blocks/site/container.astro";
import Prose from "$brand/blocks/site/prose.astro";
import PictureCard from "$brand/components/picture-card.astro";
import Byline from "$brand/blocks/content/byline.astro";
import PostContents from "$brand/blocks/content/post-contents.astro";
import PostHeader from "$brand/blocks/content/post-header.astro";
import PostMeta from "$brand/blocks/content/post-meta.astro";
import ShareBar from "$brand/blocks/content/share-bar.astro";
import { headingsOf } from "../../lib/headings";
import { author, site, topicTone } from "../../lib/example";

export const prerender = false;

const { id } = Astro.params;
const all = (await getCollection("blog")).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const entry = all.find((e) => e.id === id);
if (!entry) return Astro.redirect("/404");

const { Content } = await render(entry);
const { data } = entry;
const toc = headingsOf(entry.body ?? "");
const url = `${site.url}/blog/${entry.id}`;
const related = all.filter((e) => e.id !== entry.id).slice(0, 3);
const by = { name: data.author ?? author.name, symbol: author.symbol };
---

<Site head={{ site: "blog", title: `${data.title} — astro-app`, description: data.summary ?? "An example post.", url }}>
  <article class="pb-28 md:pb-36">
    <PostHeader layout="wide" title={data.title} summary={data.summary} date={data.date} readingTime={data.readingTime} updated={data.updated} topic={data.topic} tone={topicTone} author={by} back={{ label: "All posts", href: "/blog" }} art={data.art} class="pt-10 md:pt-16" />

    <Container size="wide">
      <div class="mt-12 lg:mt-16 lg:grid lg:grid-cols-[12rem_minmax(0,1fr)] lg:gap-x-16">
        <aside class="hidden lg:block">
          {toc.length > 0 && <PostContents items={toc} variant="rail" class="sticky top-24" />}
        </aside>
        <div class="max-w-[40rem] min-w-0">
          <Prose class="text-[1.125rem] [&_h2]:mt-14 [&_h2]:text-[1.75rem] [&_p]:leading-[1.75]">
            <Content />
          </Prose>
          <ShareBar url={url} title={data.title} class="mt-16" />
          <div class="mt-10 border-t border-border pt-8"><Byline name={by.name} symbol={by.symbol} links={author.links} /></div>
        </div>
      </div>
    </Container>

    {
      related.length > 0 && (
        <Container size="wide" class="mt-24 md:mt-32">
          <h2 class="text-[clamp(2rem,4vw,3.25rem)] leading-[1] font-medium tracking-[-0.04em] text-foreground">More from the blog</h2>
          <div class="mt-10 grid gap-x-6 gap-y-14 sm:grid-cols-2 lg:grid-cols-3">
            {related.map((p) => (
              <PictureCard title={p.data.title} dek={p.data.summary} art={p.data.art} href={`/blog/${p.id}`} as="h3">
                <PostMeta slot="head" post={{ title: p.data.title, date: p.data.date, readingTime: p.data.readingTime, topic: p.data.topic }} tone={topicTone} />
              </PictureCard>
            ))}
          </div>
        </Container>
      )
    }
  </article>
</Site>
