---
// The 404: the kit's NotFoundPage.
import Site from "../layouts/Site.astro";
import NotFoundPage from "$brand/blocks/content/not-found-page.astro";
import { notFoundData } from "../lib/example";
---

<Site head={{ site: "freeoxide", title: "Page not found — astro-app", description: "This URL doesn't point to anything.", url: "https://example.com/404" }}>
  <NotFoundPage data={notFoundData} />
</Site>
