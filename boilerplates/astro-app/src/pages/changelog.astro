---
// The changelog as a timeline: the intro with the latest release, the
// numbers, search and kind filters, then every release on the rail. The
// releases are example content (lib/example.ts).
import Site from "../layouts/Site.astro";
import ReleaseTimelinePage from "$brand/blocks/content/release-timeline-page.astro";
import { changelog, releases } from "../lib/example";
---

<Site head={{ site: "freeoxide", title: "Changelog — astro-app", description: "Every release, every change. Example content.", url: "https://example.com/changelog" }}>
  <ReleaseTimelinePage releases={releases} {...changelog} filters />
</Site>
