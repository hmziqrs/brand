---
// A docs page opens DocsReference on its own page. An id that matches
// nothing goes to the 404.
import Site from "../../layouts/Site.astro";
import DocsReference from "$brand/blocks/content/docs-reference.astro";
import { docsSite } from "../../lib/docs-site";

export const prerender = true;

export async function getStaticPaths() {
  const { pages } = await docsSite(undefined);
  return Object.keys(pages).map((id) => ({ params: { id } }));
}

const { id } = Astro.params;
const site = await docsSite(id);
const page = site.pages[id ?? ""];
if (!page) return Astro.redirect("/404");
---

<Site head={{ site: "freeoxide", title: `${page.title} — astro-app docs`, description: page.desc ?? "Example docs page.", url: `https://example.com/docs/${page.key}` }}>
  <DocsReference site={site} here="/docs" prefix="docs" offset={64} />
</Site>
