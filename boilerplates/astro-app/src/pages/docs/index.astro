---
// The docs: every page of src/content/docs in DocsReference's three
// columns, the menu and search on the left, the page in the middle and "On
// this page" on the right. The words are example copy.
import Site from "../../layouts/Site.astro";
import DocsReference from "$brand/blocks/content/docs-reference.astro";
import { docsSite } from "../../lib/docs-site";

const site = await docsSite();
---

<Site head={{ site: "freeoxide", title: "Docs — astro-app", description: "Example docs, written in Markdown through the kit's blocks.", url: "https://example.com/docs" }}>
  <DocsReference site={site} here="/docs" prefix="docs" offset={64} />
</Site>
