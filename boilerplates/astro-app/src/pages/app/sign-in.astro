---
import { actions } from "astro:actions";
import { siGithub, siGoogle } from "simple-icons";
import SignInForm from "$brand/blocks/app/auth/sign-in-form.astro";
import AuthFrame from "../../components/app/auth-frame.astro";
import AppDocument from "../../components/app/app-document.astro";
import type { FormResult, Provider } from "$brand/blocks/app/auth/types";

/*
 * The sign-in page (app-blocks.md, phase 10): the split AuthLayout with the
 * product's rings, one form around SignInForm, posted to the signIn action
 * with accept: "form" — so the same markup works with JavaScript off, and
 * the action's answer maps to the FormResult the block takes. Both providers
 * are here too: GitHub works, and Google's endpoint turns straight back
 * around with the failure in the URL, so it shows without JavaScript too.
 *
 * The action result is read in the page's frontmatter, before any markup:
 * AppDocument closes a real head before this content renders, so the call
 * costs nothing — Astro only ever skips the head it would have had to
 * synthesize itself.
 */
const action = Astro.getActionResult(actions.signIn);

let result: FormResult;
let values: { email?: string } = {};
if (action?.data?.ok === false) {
  result = { message: action.data.message, field: action.data.field };
  values = action.data.values ?? {};
} else if (action?.data?.ok) {
  return Astro.redirect(action.data.redirectTo ?? "/app/overview", 303);
}

// The Google provider's way back in.
const google = Astro.url.searchParams.get("provider") === "google";
if (google && !result) result = { message: "Google sign-in isn't working right now. Try another way." };

const providers: Provider[] = [
  { id: "github", label: "GitHub", icon: siGithub, href: "/app/sign-in/github" },
  { id: "google", label: "Google", icon: siGoogle, href: "/app/sign-in/google" },
];
---

<AppDocument title="Sign in — astro-app">
  <AuthFrame variant="split" title="Sign in" description="Sign in to your Sightline workspace.">
    <form method="POST" action={actions.signIn}>
      <SignInForm
        result={result}
        values={values}
        providers={providers}
        links={{ signUp: "/app/sign-up", forgotPassword: "/app/forgot-password" }}
      />
    </form>
  </AuthFrame>
</AppDocument>
