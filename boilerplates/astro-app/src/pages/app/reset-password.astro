---
import { actions } from "astro:actions";
import ResetPasswordForm from "$brand/blocks/app/auth/reset-password-form.astro";
import AuthFrame from "../../components/app/auth-frame.astro";
import type { FormResult } from "$brand/blocks/app/auth/types";

/*
 * The reset-password page (app-blocks.md, phase 10): the new password when
 * the link is good, the explanation and the way to a new link when it isn't.
 * state=expired shows the expired link.
 */
const action = Astro.getActionResult(actions.resetPassword);

let result: FormResult;
if (action?.data?.ok === false) {
  result = { message: action.data.message, field: action.data.field };
}

const status = action?.data?.ok && action.data.done ? "done" : Astro.url.searchParams.get("state") === "expired" ? "expired" : "ready";
---

<AuthFrame title="Reset your password" description="Pick a new password for your account.">
  <form method="POST" action={actions.resetPassword}>
    <ResetPasswordForm result={result} status={status} links={{ forgotPassword: "/app/forgot-password", signIn: "/app/sign-in" }} />
  </form>
</AuthFrame>
