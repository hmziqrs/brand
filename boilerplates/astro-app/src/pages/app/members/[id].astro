---
import AppPage from "$brand/blocks/app/shell/app-page.astro";
import ErrorState from "$brand/blocks/app/states/error-state.astro";
import DetailSection from "$brand/blocks/app/details/detail-section.astro";
import SkeletonDetails from "$brand/blocks/app/states/skeleton-details.astro";
import { Button } from "$brand/starwind/button";
import Workspace from "../../../components/app/workspace.astro";
import MemberContent from "../../../components/app/member-content.astro";
import Deferred from "../../../components/app/deferred.astro";
import { demoLoad } from "../../../lib/app/demo-state";
import { memberById } from "../../../lib/app/roster";

/*
 * The member detail page (app-blocks.md, phase 10): the same record the
 * SvelteKit demo shows. An unknown id is the not-found state with the way
 * back; the page takes pending (the same sections with skeletons in their
 * panels), error, offline and denied.
 */
const load = demoLoad(Astro.url.searchParams.get("state"), { denied: true });
const member = memberById(Astro.params.id ?? "");
---

<Workspace currentPath="/app/members" state={load.state} breadcrumbs={[{ label: "Members", href: "/app/members" }, ...(member ? [{ label: member.name }] : [])]}>
  {
    !member ? (
      <AppPage>
        <div class="mt-8">
          <ErrorState kind="not-found">
            <Fragment slot="actions">
              <Button variant="outline" href="/app/members">Back to members</Button>
            </Fragment>
          </ErrorState>
        </div>
      </AppPage>
    ) : load.status === "error" ? (
      <AppPage>
        <div class="mt-8">
          <ErrorState kind={load.kind} retryHref={`/app/members/${member.id}`}>
            {load.kind === "denied" && (
              <Fragment slot="actions">
                <Button variant="outline" href="/app/members">Back to members</Button>
              </Fragment>
            )}
          </ErrorState>
        </div>
      </AppPage>
    ) : load.status === "pending" ? (
      <Deferred server:defer ms={600}>
        <div slot="fallback">
          <AppPage>
            <div class="mt-8 flex flex-col gap-8">
              {/* The sections keep their shape: the skeleton stands exactly
                  where the rows land, inside the same panels. */}
              <DetailSection title="Profile">
                <SkeletonDetails rows={4} />
              </DetailSection>
              <DetailSection title="Access">
                <SkeletonDetails rows={4} />
              </DetailSection>
            </div>
          </AppPage>
        </div>
        <MemberContent member={member} />
      </Deferred>
    ) : (
      <MemberContent member={member} />
    )
  }
</Workspace>
