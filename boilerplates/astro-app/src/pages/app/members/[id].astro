---
import AppPage from "$brand/blocks/app/shell/app-page.astro";
import AppPageHeader from "$brand/blocks/app/shell/app-page-header.astro";
import ErrorState from "$brand/blocks/app/states/error-state.astro";
import DetailSection from "$brand/blocks/app/details/detail-section.astro";
import SkeletonDetails from "$brand/blocks/app/states/skeleton-details.astro";
import { Button } from "$brand/starwind/button";
import { Skeleton } from "$brand/starwind/skeleton";
import Workspace from "../../../components/app/workspace.astro";
import MemberContent from "../../../components/app/member-content.astro";
import Deferred from "../../../components/app/deferred.astro";
import AppDocument from "../../../components/app/app-document.astro";
import { demoLoad } from "../../../lib/app/demo-state";
import { memberById } from "../../../lib/app/roster";

/*
 * The member detail page (app-blocks.md, phase 10): the same record the
 * SvelteKit demo shows. An unknown id is the not-found state with the way
 * back; the page takes pending (the same sections with skeletons in their
 * panels), error, offline and denied.
 */
const load = demoLoad(Astro.url.searchParams.get("state"), { denied: true });
const member = memberById(Astro.params.id ?? "");

// The record's own name, the way the header reads it; an unknown id names
// what the page shows instead.
const title = `${member ? member.name : "Not found"} — astro-app`;
---

<AppDocument {title}>
  <Workspace
    currentPath="/app/members"
    state={load.state}
    /* No breadcrumbs here: the page's own header carries them (one
       "Breadcrumb" nav, the way the Svelte twin's page does — passing them
       to the shell too drew two same-named navs, an axe landmark-unique
       finding). */
  >
    {
      !member ? (
        <AppPage>
          <div class="mt-8">
            <ErrorState kind="not-found">
              <Fragment slot="actions">
                <Button variant="outline" href="/app/members">Back to members</Button>
              </Fragment>
            </ErrorState>
          </div>
        </AppPage>
      ) : load.status === "error" ? (
        /* The error face keeps the page's frame — the record's name and the
           way back — as the Svelte twin's does: its DataState swaps only
           what sits below the header. No "Edit" here: the sheet it opens
           arrives with the record, so the button would be dead. */
        <AppPage>
          <AppPageHeader
            title={member.name}
            breadcrumbs={[{ label: "Members", href: "/app/members" }, { label: member.name }]}
            back={{ label: "Members", href: "/app/members" }}
          />
          <div class="mt-8">
            <ErrorState kind={load.kind} retryHref={`/app/members/${member.id}`}>
              {load.kind === "denied" && (
                <Fragment slot="actions">
                  <Button variant="outline" href="/app/members">Back to members</Button>
                </Fragment>
              )}
            </ErrorState>
          </div>
        </AppPage>
      ) : load.status === "pending" ? (
        <Deferred server:defer ms={600}>
          {/* The pending face's semantics, as the members page has them. */}
          <div slot="fallback" aria-busy="true">
            <span class="sr-only" role="status">Loading member</span>
            <AppPage>
              {/* The frame stays, as on the error face — and as the Svelte
                  twin's does: its DataState swaps only what sits below the
                  header. */}
              <AppPageHeader
                title={member.name}
                breadcrumbs={[{ label: "Members", href: "/app/members" }, { label: member.name }]}
                back={{ label: "Members", href: "/app/members" }}
              />
              <div class="mt-8 flex flex-col gap-8">
                {/* The sections keep their shape — each with its own
                    description, so the head is the height the record's head
                    will be too — and the skeleton stands exactly where the
                    rows land, inside the same panels. That includes the
                    Remove panel, whose skeleton holds the same
                    paragraph-and-button line the real one draws: two lines
                    and a full-width button below sm, one line and a button
                    at home from sm. */}
                <DetailSection title="Profile" description="Who they are in the workspace.">
                  <SkeletonDetails rows={4} />
                </DetailSection>
                <DetailSection title="Access" description="How they sign in, and when they were last here.">
                  <SkeletonDetails rows={4} />
                </DetailSection>
                <DetailSection tone="destructive" title="Remove from workspace">
                  <div class="flex flex-col gap-3 py-4 sm:flex-row sm:items-center sm:justify-between" aria-hidden="true">
                    <Skeleton class="h-10 sm:h-5 sm:w-72" />
                    <Skeleton class="h-9 shrink-0 sm:w-44" />
                  </div>
                </DetailSection>
              </div>
            </AppPage>
          </div>
          <MemberContent member={member} />
        </Deferred>
      ) : (
        <MemberContent member={member} />
      )
    }
  </Workspace>
</AppDocument>
