---
import { actions } from "astro:actions";
import ForgotPasswordForm from "$brand/blocks/app/auth/forgot-password-form.astro";
import AuthFrame from "../../components/app/auth-frame.astro";
import AppDocument from "../../components/app/app-document.astro";
import type { FormResult } from "$brand/blocks/app/auth/types";

/*
 * The forgot-password page (app-blocks.md, phase 10): one email field, posted
 * to the forgotPassword action. The resend waits thirty seconds, and the
 * success line says the same thing whether or not the account exists.
 */
const action = Astro.getActionResult(actions.forgotPassword);

let result: FormResult;
if (action?.data?.ok === false) {
  result = { message: action.data.message, field: action.data.field };
}
---

<AppDocument title="Forgot your password? — astro-app">
  <AuthFrame title="Forgot your password?" description="We'll email you a link to set a new one.">
    <form method="POST" action={actions.forgotPassword}>
      <ForgotPasswordForm
        result={result}
        sentTo={action?.data?.ok ? action.data.sentTo : undefined}
        resendAfter={30}
        links={{ signIn: "/app/sign-in" }}
      />
    </form>
  </AuthFrame>
</AppDocument>
