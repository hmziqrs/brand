---
import { actions } from "astro:actions";
import { siGithub, siGoogle } from "simple-icons";
import SignUpForm from "$brand/blocks/app/auth/sign-up-form.astro";
import AuthFrame from "../../components/app/auth-frame.astro";
import AppDocument from "../../components/app/app-document.astro";
import type { FormResult, Provider } from "$brand/blocks/app/auth/types";

/*
 * The sign-up page (app-blocks.md, phase 10): the centered layout, the
 * password rules as a ticking checklist, posted to the signUp action. The
 * email "taken@example.com" is the scripted failure; success redirects to
 * verify-email with the address. Both providers sit above the fields, as on
 * the sign-in page: GitHub works, and Google comes straight back with its
 * scripted failure in the URL, so it shows with JavaScript off too.
 */
const action = Astro.getActionResult(actions.signUp);

let result: FormResult;
let values: { name?: string; email?: string } = {};
if (action?.data?.ok === false) {
  result = { message: action.data.message, field: action.data.field };
  values = action.data.values ?? {};
} else if (action?.data?.ok) {
  return Astro.redirect(action.data.redirectTo ?? "/app/verify-email", 303);
}

const google = Astro.url.searchParams.get("provider") === "google";
if (google && !result) result = { message: "Google sign-in isn't working right now. Try another way." };

const passwordRules = [
  { label: "At least 8 characters", pattern: ".{8,}" },
  { label: "One uppercase letter", pattern: "[A-Z]" },
  { label: "One number", pattern: "\\d" },
];

const providers: Provider[] = [
  { id: "github", label: "GitHub", icon: siGithub, href: "/app/sign-up/github" },
  { id: "google", label: "Google", icon: siGoogle, href: "/app/sign-up/google" },
];
---

<AppDocument title="Create your account — astro-app">
  <AuthFrame title="Create your account" description="Start tracking your product with Sightline.">
    <form method="POST" action={actions.signUp}>
      <SignUpForm
        result={result}
        values={values}
        providers={providers}
        passwordRules={passwordRules}
        links={{ signIn: "/app/sign-in", terms: "/terms", privacy: "/privacy" }}
      />
    </form>
  </AuthFrame>
</AppDocument>
