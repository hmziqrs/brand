---
// The FAQ: a search that narrows the questions, the topics as contents and each topic's numbered questions. The words are example copy.
import Site from "../layouts/Site.astro";
import FaqPage from "$brand/blocks/content/faq-page.astro";
import { faqData } from "../lib/example";
---

<Site head={{ site: "freeoxide", title: "FAQ — astro-app", description: "Straight answers, all on one page. Example content.", url: "https://example.com/faq" }}>
  <FaqPage data={faqData} class="[--pages-top:4rem]" />
</Site>
