---
import Container from "$brand/blocks/site/container.astro";
import PageIntro from "$brand/blocks/site/page-intro.astro";
import SiteLayout from "$brand/blocks/site/site-layout.astro";
import Segmented from "$brand/components/segmented.astro";
import DotField from "$brand/components/dot-field.astro";
import FaqSection from "$brand/blocks/site/faq-section.astro";
import PricingCard from "$brand/blocks/site/pricing-card.astro";
import PricingCompare from "$brand/blocks/site/pricing-compare.astro";
import PricingPage from "$brand/blocks/site/pricing-page.astro";
import ThemeInit from "../../components/theme-init.astro";
import ThemeToggle from "../../components/theme-toggle.astro";
import { productPricing, studioPricing } from "../../components/kit/pricing-data";
---

<SiteLayout site="example" maker="the kit" layout="page" mainClassName="gap-14 pt-12 pb-20 md:pt-20" head={{ site: "blog", title: "Pricing pages — the kit", description: "The pricing page block and its parts from the Astro kit.", url: "https://example.com/kit/pricing" }}>
  <ThemeInit slot="head" />
  <ThemeToggle slot="extra" />

  <Container>
    <PageIntro class="max-w-2xl">
      <Fragment slot="kicker">The kit · pricing pages</Fragment>
      <Fragment slot="title">Pricing pages</Fragment>
      <Fragment slot="lede">The pricing page block across the whole width for a subscription product and for a studio, then the plan card, the compare table, the questions and the dot field it is made of.</Fragment>
    </PageIntro>
  </Container>

  <section id="piece-pricing-page" class="flex flex-col gap-4 border-t pt-8">
    <Container size="wide"><h2 class="text-lg font-medium">PricingPage</h2></Container>
    <PricingPage {...productPricing} class="[--pricing-top:0px]" />
    <Container size="wide"><p class="text-[0.8125rem] text-muted-foreground">torii.tools: monthly, yearly or lifetime; the plan row stays under the top while you read the table, and the dots answer the cursor.</p></Container>
    <PricingPage {...studioPricing} id="studio" class="[--pricing-top:0px]" />
    <Container size="wide"><p class="text-[0.8125rem] text-muted-foreground">oxlabs.dev: four engagements, a commitment switch.</p></Container>
  </section>

  <section id="piece-pricing-card" class="flex flex-col gap-4 border-t pt-8">
    <Container size="wide">
      <h2 class="text-lg font-medium">PricingCard</h2>
      <div data-pricing-root data-mode="0" class="mt-4 flex flex-col gap-6">
        <Segmented label="Billing" value="0" options={productPricing.billing.options.map((label, i) => ({ value: String(i), label }))} data-pricing-mode />
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {productPricing.tiers.map((tier) => <PricingCard tier={tier} />)}
        </div>
      </div>
    </Container>
  </section>

  <section id="piece-pricing-compare" class="flex flex-col gap-4 border-t pt-8">
    <Container size="wide">
      <h2 class="text-lg font-medium">PricingCompare</h2>
      <PricingCompare tiers={studioPricing.tiers} compare={studioPricing.compare} id="pricing-only-studio" class="mt-4" />
    </Container>
  </section>

  <section id="piece-faq-section" class="flex flex-col gap-4 border-t pt-8">
    <Container size="wide">
      <h2 class="text-lg font-medium">FaqSection</h2>
      <FaqSection faq={productPricing.faq} class="mt-4" />
    </Container>
  </section>

  <section id="piece-dot-field" class="flex flex-col gap-4 border-t pt-8">
    <Container size="wide"><h2 class="text-lg font-medium">DotField</h2></Container>
    <div class="relative isolate flex h-[28rem] items-center justify-center overflow-hidden">
      <DotField />
      <p class="text-center text-5xl font-semibold tracking-[-0.04em]">Priced in writing, before any code.</p>
    </div>
  </section>
</SiteLayout>
