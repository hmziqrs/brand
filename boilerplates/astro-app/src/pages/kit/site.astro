      legal="© 2026 example · MIT / Apache-2.0"
    />
  </section>

  <section id="piece-glyph-footer" class="flex flex-col gap-4 border-t pt-8">
    <Container size="wide"><h2 class="text-lg font-medium">GlyphFooter</h2></Container>
    <GlyphFooter
      site="example"
      maker="by example"
