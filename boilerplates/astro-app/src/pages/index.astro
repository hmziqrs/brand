---
// The landing page for a product site: ProductHero centered over a
// MaterialWash, a catalog, the steps and the stat tiles. Every word is
// example copy (lib/example.ts): replace it with the project's own.
import { ArrowRight } from "@lucide/astro";
import { siGithub } from "simple-icons";
import Site from "../layouts/Site.astro";
import Container from "$brand/blocks/site/container.astro";
import ButtonLink from "$brand/blocks/site/button-link.astro";
import ProductHero from "$brand/blocks/sections/product-hero.astro";
import CatalogSection from "$brand/blocks/sections/catalog-section.astro";
import StepsSection from "$brand/blocks/sections/steps-section.astro";
import SectionHead from "$brand/blocks/sections/section-head.astro";
import MaterialWash from "$brand/components/material-wash.astro";
import StatTile from "$brand/components/stat-tile.astro";
import Tag from "$brand/components/tag.astro";
import BrandIcon from "$brand/components/brand-icon.astro";
import TerminalWindow from "$brand/components/terminal-window.astro";
import TerminalBody from "$brand/components/terminal-body.astro";
import TerminalLine from "$brand/components/terminal-line.astro";
import StepDemo from "../components/step-demo.astro";
import { landing, site } from "../lib/example";
---

<Site head={{ site: "freeoxide", title: "astro-app — a hmziq site", description: "The Astro starter for hmziq sites: the theme, the brand kit, a product landing page and the content pages.", url: "https://example.com/" }}>
  <ProductHero layout="centered" title={landing.hero.title} accent={landing.hero.accent} lede={landing.hero.lede} install={site.install}>
    <Tag slot="eyebrow" tone="orange" marker class="font-mono uppercase">{landing.hero.eyebrow}</Tag>
    <Fragment slot="actions">
      <ButtonLink href="/docs/installation" size="lg">Get started<ArrowRight data-icon="inline-end" /></ButtonLink>
      <ButtonLink href="https://github.com" size="lg" variant="outline"><BrandIcon icon={siGithub} data-icon="inline-start" />GitHub</ButtonLink>
    </Fragment>
    <MaterialWash slot="stage" preset="white-sweep" />
    <TerminalWindow slot="visual" title="example-tool setup">
      <TerminalBody>
        {landing.terminal.map((line) => <TerminalLine line={line} />)}
      </TerminalBody>
    </TerminalWindow>
  </ProductHero>

  <CatalogSection title={landing.catalog.title} accent={landing.catalog.accent} tags={landing.catalog.tags} lede={landing.catalog.lede} items={landing.catalog.items} picked={landing.catalog.picked}>
    <div class="mt-12 grid grid-cols-2 gap-3 lg:grid-cols-3">
      {landing.stats.map((s, i) => <StatTile {...s} class={i === 0 ? "col-span-2 lg:col-span-1" : ""} />)}
    </div>
  </CatalogSection>

  <StepsSection kicker={landing.steps.kicker} title={landing.steps.title} lede={landing.steps.lede} steps={landing.steps.items}>
    <ButtonLink slot="actions" href="/docs/quick-start" size="lg">Quick start<ArrowRight data-icon="inline-end" /></ButtonLink>
    <StepDemo slot="demo-1" i={0} />
    <StepDemo slot="demo-2" i={1} />
    <StepDemo slot="demo-3" i={2} />
  </StepsSection>

  <section class="pb-24 sm:pb-32">
    <Container size="wide">
      <SectionHead layout="center" kicker={landing.closing.kicker} title={landing.closing.title} lede={landing.closing.lede} />
      <div class="mt-9 flex flex-wrap justify-center gap-3">
        <ButtonLink href="/docs/installation" size="lg">Read the docs</ButtonLink>
        <ButtonLink href="/contact" size="lg" variant="outline">Get in touch</ButtonLink>
      </div>
    </Container>
  </section>
</Site>
