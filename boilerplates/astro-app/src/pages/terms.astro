---
// The terms page: LegalPage with the terms document first. The words are example copy.
import Site from "../layouts/Site.astro";
import LegalPage from "$brand/blocks/content/legal-page.astro";
import { privacy, terms } from "../lib/example";
---

<Site head={{ site: "freeoxide", title: "Terms of use — astro-app", description: "The terms of using this software and site. Example content.", url: "https://example.com/terms" }}>
  <LegalPage docs={[terms, privacy]} class="[--pages-top:4rem]" />
</Site>
