---
import { Check, GitBranch, Globe, Monitor, Server, Smartphone, SquareTerminal } from "@lucide/astro";
import { cn } from "$brand/utils";

interface Props {
  i: number;
}

const { i } = Astro.props;
const asks = [
  { Icon: Smartphone, label: "Phone app", key: "1" },
  { Icon: Monitor, label: "Desktop app", key: "2" },
  { Icon: Globe, label: "Web app", key: "3" },
  { Icon: SquareTerminal, label: "CLI tool", key: "4" },
  { Icon: Server, label: "API and database", key: "5" },
];
const builds = ["iOS", "Android", "macOS", "Windows", "Linux", "Web"];
const toggles: [string, boolean][] = [
  ["Sync on Wi-Fi only", true],
  ["Keep photos offline", true],
  ["Daily summary", false],
  ["Share with team", true],
];
const cursors = [
  { name: "Dana", ink: "text-pink", fill: "bg-pink", drift: "story-drift-a", place: "-top-[3%] right-[2%]" },
  { name: "Sam", ink: "text-teal", fill: "bg-teal", drift: "story-drift-b", place: "bottom-[6%] left-[16%]" },
];
---

{
  i === 0 ? (
    <div data-step-picker class="w-full max-w-[250px] rounded-xl bg-background p-1.5 shadow-[0_30px_50px_-30px_color-mix(in_oklab,black_70%,transparent)] ring-1 ring-foreground/12" role="presentation">
      <p class="px-2 pt-1.5 pb-1 font-mono text-[10px] tracking-wide text-muted-foreground uppercase">What are we building?</p>
      {asks.map((a, j) => (
        <button type="button" data-pick={j} aria-current={j === 1 ? "true" : undefined} class="group/ask flex w-full items-center gap-2.5 rounded-lg px-2 py-2 text-left text-[13px] text-foreground transition-colors outline-none focus-visible:ring-2 focus-visible:ring-ring/50 aria-[current=true]:bg-primary aria-[current=true]:text-primary-foreground">
          <a.Icon class="lucide size-4" />
          {a.label}
          <kbd class="ml-auto rounded px-1 font-mono text-[10px] text-muted-foreground ring-1 ring-foreground/15 group-aria-[current=true]/ask:text-inherit group-aria-[current=true]/ask:ring-primary-foreground/40">{a.key}</kbd>
        </button>
      ))}
    </div>
  ) : i === 1 ? (
    <div class="relative w-full max-w-[260px]">
      <div class="relative aspect-[4/5] overflow-hidden rounded-xl bg-background ring-1 ring-foreground/10">
        <div class="flex items-center justify-between border-b border-foreground/10 px-3 py-2">
          <span class="font-mono text-[10px] text-foreground">build 8 · Settings</span>
          <span class="rounded-md bg-primary px-1.5 py-0.5 text-[10px] font-medium text-primary-foreground">Export</span>
        </div>
        <ul class="space-y-1.5 p-3 text-[11px] text-foreground">
          {toggles.map(([label, on]) => (
            <li class="flex items-center justify-between rounded-lg px-2.5 py-2 ring-1 ring-foreground/10">
              <span>{label}</span>
              <span class={cn("flex h-3.5 w-6 items-center rounded-full p-0.5", on ? "justify-end bg-primary" : "justify-start bg-foreground/25")}><span class="size-2.5 rounded-full bg-background"></span></span>
            </li>
          ))}
        </ul>
      </div>
      <div class="absolute -right-3 bottom-[34%] max-w-[180px] rounded-xl bg-background p-2.5 text-[12px] leading-snug text-foreground shadow-lg ring-1 ring-foreground/12">
        <p class="font-medium">Dana</p>
        <p class="text-foreground/85">Can export sit top right?</p>
        <p class="mt-1.5 border-t border-foreground/10 pt-1.5"><span class="font-medium">Sam</span> <span class="text-foreground/85">Moved in build 9.</span></p>
      </div>
      {cursors.map((c) => (
        <span aria-hidden="true" class={cn("absolute inline-flex items-start", c.drift, c.place)}>
          <svg viewBox="0 0 16 16" class={cn("size-4 drop-shadow-[0_1px_2px_color-mix(in_oklab,black_40%,transparent)]", c.ink)}>
            <path d="M2 1.5 14 7l-5.2 1.6L6.6 14z" fill="currentColor" stroke="var(--background)" stroke-width="1" stroke-linejoin="round" />
          </svg>
          <span class={cn("mt-3 -ml-0.5 rounded-full px-2 py-0.5 text-[11px] font-medium whitespace-nowrap text-on-orange", c.fill)}>{c.name}</span>
        </span>
      ))}
    </div>
  ) : (
    <div data-step-fan class="flex w-full items-center gap-4">
      <div class="flex w-[34%] shrink-0 flex-col items-center gap-2 rounded-lg px-2 py-4 ring-1 ring-primary">
        <GitBranch class="lucide size-6 text-primary" />
        <span class="font-mono text-[10px] text-foreground">your repo</span>
        <span class="font-mono text-[10px] text-foreground/70">v1.0.0</span>
      </div>
      <svg aria-hidden="true" viewBox="0 0 30 90" class="h-28 w-6 shrink-0 text-primary"><path d="M0 45 C15 45 15 10 30 10 M0 45 H30 M0 45 C15 45 15 80 30 80" fill="none" stroke="currentColor" stroke-width="1.2" stroke-dasharray="3 4" /></svg>
      <ul class="grid flex-1 grid-cols-1 gap-1">
        {builds.map((b) => (
          <li class="group/build flex items-center justify-between rounded-md px-2 py-1 font-mono text-[10px] text-muted-foreground ring-1 ring-foreground/8 transition-colors duration-300 data-done:text-foreground data-done:ring-foreground/20 motion-reduce:transition-none">
            <span>{b}</span>
            <Check class="lucide hidden size-3 text-primary group-data-done/build:block" />
            <span class="size-1.5 rounded-full bg-foreground/25 group-data-done/build:hidden"></span>
          </li>
        ))}
      </ul>
    </div>
  )
}

<style is:global>
  @media (prefers-reduced-motion: no-preference) {
    .story-drift-a {
      animation: story-drift-a 7s ease-in-out infinite;
    }
    .story-drift-b {
      animation: story-drift-b 9s ease-in-out infinite;
    }
  }
  @keyframes story-drift-a {
    50% {
      translate: 40px 30px;
    }
  }
  @keyframes story-drift-b {
    50% {
      translate: -50px -20px;
    }
  }
</style>

<script>
  const still = () => matchMedia("(prefers-reduced-motion: reduce)").matches;

  function picker(root: HTMLElement) {
    const options = [...root.querySelectorAll<HTMLElement>("[data-pick]")];
    let pick = 1;
    let hover = false;
    const show = () => options.forEach((o, j) => (j === pick ? o.setAttribute("aria-current", "true") : o.removeAttribute("aria-current")));
    options.forEach((o, j) => {
      for (const type of ["pointerenter", "focus", "click"]) o.addEventListener(type, () => ((pick = j), show()));
    });
    root.addEventListener("pointerenter", () => (hover = true));
    root.addEventListener("pointerleave", () => (hover = false));
    if (!still()) setInterval(() => !hover && ((pick = (pick + 1) % options.length), show()), 1500);
  }

  function fan(root: HTMLElement) {
    const rows = [...root.querySelectorAll<HTMLElement>("li")];
    let filled = still() ? rows.length : 0;
    const show = () => rows.forEach((r, k) => r.toggleAttribute("data-done", k < filled));
    show();
    if (!still()) setInterval(() => ((filled = filled >= rows.length + 3 ? 0 : filled + 1), show()), 420);
  }

  for (const root of document.querySelectorAll<HTMLElement>("[data-step-picker]")) picker(root);
  for (const root of document.querySelectorAll<HTMLElement>("[data-step-fan]")) fan(root);
</script>
