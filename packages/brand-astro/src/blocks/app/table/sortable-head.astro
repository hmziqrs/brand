---
import type { HTMLAttributes } from "astro/types";
import { ArrowDown, ArrowUp, ChevronsUpDown } from "@lucide/astro";
import { cn } from "$brand/utils";
import { TableHead } from "$brand/starwind/table";

/*
 * A column header that sorts: a th that says which way it's pointing
 * (aria-sort) and holds the link that turns the sort, so it works with no
 * JavaScript. The arrow follows the state; an unsorted column shows the
 * both-ways chevrons. Anything that shares the cell — the select-all
 * checkbox of a selection column — comes in through the `leading` slot.
 */

interface Props extends HTMLAttributes<"th"> {
  label: string;
  sorted?: false | "asc" | "desc";
  href: string;
}

const { label, sorted = false, href, class: className, ...rest } = Astro.props;

const ariaSort = sorted === "asc" ? "ascending" : sorted === "desc" ? "descending" : "none";
const Icon = sorted === "asc" ? ArrowUp : sorted === "desc" ? ArrowDown : ChevronsUpDown;
const hasLeading = Astro.slots.has("leading");
---

<TableHead data-slot="sortable-head" aria-sort={ariaSort} class={cn("text-foreground", className)} {...rest}>
  <span class="flex items-center gap-2.5">
    {hasLeading && <slot name="leading" />}
    <a
      href={href}
      class="inline-flex items-center gap-1 rounded-sm outline-none transition-colors focus-visible:ring-3 focus-visible:ring-ring/50"
    >
      {label}
      <Icon class="lucide size-3.5 text-muted-foreground" aria-hidden="true" />
    </a>
  </span>
</TableHead>
