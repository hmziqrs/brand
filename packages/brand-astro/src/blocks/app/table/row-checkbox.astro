---
import type { HTMLAttributes } from "astro/types";
import { Check } from "@lucide/astro";
import { cn } from "$brand/utils";

/*
 * The checkbox in one row of a selection column. It names the row it picks
 * ("Select Ada Lovelace"), so screen readers say what's being chosen. A
 * native input, as the contract's Astro line says; the selection script
 * reads it, and its value rides along when the form submits.
 */

interface Props extends Omit<HTMLAttributes<"input">, "type" | "checked"> {
  checked?: boolean;
  label: string;
}

const { checked = false, label, class: className, ...rest } = Astro.props;
---

<span class="relative inline-flex align-middle">
  <input
    type="checkbox"
    data-slot="row-checkbox"
    checked={checked}
    aria-label={label}
    class={cn(
      "peer size-4 appearance-none rounded-[4px] border border-input bg-background shadow-xs outline-none transition-colors",
      "checked:border-primary checked:bg-primary",
      "focus-visible:ring-3 focus-visible:ring-ring/50 focus-visible:border-ring",
      className,
    )}
    {...rest}
  />
  <Check
    class="lucide pointer-events-none absolute top-1/2 left-1/2 size-3.5 -translate-x-1/2 -translate-y-1/2 text-primary-foreground opacity-0 peer-checked:opacity-100"
    aria-hidden="true"
  />
</span>
