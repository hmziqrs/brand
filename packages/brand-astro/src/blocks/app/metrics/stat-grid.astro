---
import type { HTMLAttributes } from "astro/types";
import { cn } from "$brand/utils";

/*
 * StatCards in a grid with a gap. Each card is its own outline card, so the
 * grid draws no lines or fill of its own. Two columns on phones, the chosen
 * count from sm.
 */

interface Props extends HTMLAttributes<"div"> {
  columns?: 2 | 3 | 4;
}

const { columns = 4, class: className, ...rest } = Astro.props;

// Written out in full, the way the kit writes tone classes, and matched
// by SkeletonStats so a loading grid stands exactly where this one lands.
const counts: Record<2 | 3 | 4, string> = {
  2: "sm:grid-cols-2",
  3: "sm:grid-cols-3",
  4: "sm:grid-cols-4",
};
---

<div
  data-slot="stat-grid"
  class={cn("grid grid-cols-2 gap-3", counts[columns], className)}
  {...rest}
>
  <slot />
</div>
