---
import type { HTMLAttributes } from "astro/types";
import { LoaderCircle } from "@lucide/astro";
import { cn } from "$brand/utils";
import { Button } from "$brand/starwind/button";
import { Input } from "$brand/starwind/input";
import Notice from "$brand/components/notice.astro";
import AuthField from "./auth-field.astro";
import type { FormResult } from "./types";

/*
 * The inside of a forgot-password form: the email field and the send button.
 * The page owns the <form>; the action's FormResult comes back as `result`.
 * Once a link is on its way (`sentTo`), the same line says so whether or not
 * the account exists, and the button turns into a resend that counts down.
 * The countdown runs in the browser only, so a page with no JavaScript keeps
 * the resend usable; choosing it restarts the count.
 */

interface Props extends HTMLAttributes<"div"> {
  result?: FormResult;
  pending?: boolean;
  /** Where the link was sent: turns the button into the counting resend. */
  sentTo?: string;
  /** Seconds the resend waits. */
  resendAfter?: number;
  links: { signIn: string };
}

const { result, pending = false, sentTo, resendAfter, links, class: className, ...rest } = Astro.props;

const email = sentTo ?? "";
const emailError = result?.field === "email" ? result.message : undefined;
const formError = result && !result.field ? result.message : undefined;
---

<div
  data-pending-label="Sending…" data-slot="forgot-password-form"
  data-result={result ? (result.field ?? "form") : undefined}
  data-sent={sentTo ? "true" : undefined} class={cn("flex flex-col gap-4", className)} {...rest}>
  {formError && (
    <div data-error-notice tabindex="-1">
      <Notice tone="destructive" title={formError} />
    </div>
  )}

  {
    sentTo && (
      <Notice tone="info" title={`If there's an account for ${sentTo}, we've sent a link to reset the password.`} />
    )
  }

  <AuthField label="Email" for="email" error={emailError}>
    <Input
      id="email"
      name="email"
      type="email"
      value={email}
      autocomplete="email"
      placeholder="you@example.com"
      disabled={pending}
      aria-invalid={emailError ? true : undefined}
      aria-describedby={emailError ? "email-error" : undefined}
    />
  </AuthField>

  <Button type="submit" data-resend class="mt-2" disabled={pending} data-resend-after={resendAfter}>
    {
      pending ? (
        <>
          <LoaderCircle class="lucide size-4 animate-spin motion-reduce:animate-none" aria-hidden="true" />
          Sending…
        </>
      ) : (
        <span data-resend-label>{sentTo ? "Send the link again" : "Send reset link"}</span>
      )
    }
  </Button>

  <p class="text-sm text-muted-foreground">
    Remembered your password?
    <a href={links.signIn} class="text-primary underline underline-offset-4 hover:underline">Sign in</a>
  </p>
</div>

<script>
  // The resend counts down in the browser only; choosing it restarts the
  // count. A page with no JavaScript never runs this, so the button stays
  // usable there.
  const run = () => {
    for (const button of document.querySelectorAll<HTMLButtonElement>("[data-resend]")) {
      const wait = Number(button.dataset.resendAfter ?? "0");
      if (!wait) continue;
      const root = button.closest<HTMLElement>("[data-slot='forgot-password-form']");
      if (!root || root.dataset.sent === undefined) continue;

      let remaining = wait;
      const label = button.querySelector<HTMLElement>("[data-resend-label]");
      const paint = () => {
        if (!label) return;
        if (remaining > 0) {
          button.disabled = true;
          label.textContent = `Send again in ${remaining}s`;
        } else {
          button.disabled = false;
          label.textContent = "Send the link again";
        }
      };
      paint();
      const timer = window.setInterval(() => {
        remaining = Math.max(0, remaining - 1);
        paint();
        if (remaining === 0) window.clearInterval(timer);
      }, 1000);
      button.addEventListener("click", () => {
        remaining = wait;
        paint();
      });
    }

    for (const root of document.querySelectorAll<HTMLElement>("[data-slot='forgot-password-form']")) {
      const refused = root.dataset.result;
      if (refused && refused !== "form") {
        root.querySelector<HTMLElement>(`[name="${refused}"]`)?.focus();
        continue;
      }
      if (refused === "form") {
        root.querySelector<HTMLElement>("[data-error-notice]")?.focus();
        continue;
      }
      root.querySelector<HTMLElement>("input")?.focus();
    }
  };
  run();
  document.addEventListener("astro:page-load", run);
</script>
