---
import type { HTMLAttributes } from "astro/types";
import { LoaderCircle } from "@lucide/astro";
import { cn } from "$brand/utils";
import { Button } from "$brand/starwind/button";
import { Input } from "$brand/starwind/input";
import Notice from "$brand/components/notice.astro";
import AuthField from "./auth-field.astro";
import PasswordInput from "./password-input.astro";
import ProviderButtons from "./provider-buttons.astro";
import type { FormResult, Provider } from "./types";

/*
 * The inside of a sign-in form: the email and password fields, the errors,
 * the submit button and the links away. The page owns the <form> and posts it
 * to its action; the action's FormResult comes back here as `result`.
 *
 * A failed sign-in keeps the email (the page hands it back through `values`)
 * and focuses the password, which is never seeded. The focus moves are the
 * script's: the first field on load, the refused field (or the password,
 * cleared and waiting) after a failed submit.
 */

interface Props extends HTMLAttributes<"div"> {
  result?: FormResult;
  pending?: boolean;
  /** The email as the page knows it: handed back after a failed sign-in. */
  values?: { email?: string };
  providers?: Provider[];
  links: { signUp?: string; forgotPassword?: string };
}

const {
  result,
  pending = false,
  values,
  providers = [],
  links,
  class: className,
  ...rest
} = Astro.props;

const email = values?.email ?? "";
const emailError = result?.field === "email" ? result.message : undefined;
const passwordError = result?.field === "password" ? result.message : undefined;
const formError = result && !result.field ? result.message : undefined;
---

<div data-pending-label="Signing in…" data-slot="sign-in-form" data-result={result ? (result.field ?? "form") : undefined} class={cn("flex flex-col gap-4", className)} {...rest}>
  {formError && (
    <div data-error-notice tabindex="-1">
      <Notice tone="destructive" title={formError} />
    </div>
  )}

  {
    providers.length > 0 && (
      <>
        <ProviderButtons providers={providers} />
        <div class="flex items-center gap-3" aria-hidden="true">
          <span class="h-px flex-1 bg-border" />
          <span class="text-xs text-muted-foreground">or</span>
          <span class="h-px flex-1 bg-border" />
        </div>
      </>
    )
  }

  <AuthField label="Email" for="email" error={emailError}>
    <Input
      id="email"
      name="email"
      type="email"
      value={email}
      autocomplete="email"
      placeholder="you@example.com"
      disabled={pending}
      aria-invalid={emailError ? true : undefined}
      aria-describedby={emailError ? "email-error" : undefined}
    />
  </AuthField>

  <AuthField label="Password" for="password" error={passwordError}>
    <Fragment slot="beside">
      {
        links.forgotPassword && (
          <a href={links.forgotPassword} class="text-sm text-primary underline underline-offset-4 hover:underline">
            Forgot your password?
          </a>
        )
      }
    </Fragment>
    <PasswordInput
      id="password"
      name="password"
      autocomplete="current-password"
      disabled={pending}
      aria-invalid={passwordError ? true : undefined}
      aria-describedby={passwordError ? "password-error" : undefined}
    />
  </AuthField>

  <Button type="submit" class="mt-2" disabled={pending}>
    {
      pending ? (
        <>
          <LoaderCircle class="lucide size-4 animate-spin motion-reduce:animate-none" aria-hidden="true" />
          Signing in…
        </>
      ) : (
        "Sign in"
      )
    }
  </Button>

  {
    links.signUp && (
      <p class="text-sm text-muted-foreground">
        Don't have an account?
        <a href={links.signUp} class="text-primary underline underline-offset-4 hover:underline">Create one</a>
      </p>
    )
  }
</div>

<script>
  // Focus, in the browser only: the first field on load; after a failed
  // submit, the field the server refused — or, when the pair just doesn't
  // match, the password field, cleared and waiting.
  const run = () => {
    for (const root of document.querySelectorAll<HTMLElement>("[data-slot='sign-in-form']")) {
      const refused = root.dataset.result;
      if (refused && refused !== "form") {
        root.querySelector<HTMLElement>(`[name="${refused}"]`)?.focus();
        continue;
      }
      if (refused === "form") {
        const password = root.querySelector<HTMLInputElement>('[name="password"]');
        if (password) {
          password.value = "";
          password.focus();
        }
        continue;
      }
      root.querySelector<HTMLElement>("input")?.focus();
    }
  };
  run();
  document.addEventListener("astro:page-load", run);
</script>
