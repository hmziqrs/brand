---
import type { HTMLAttributes } from "astro/types";
import { cn } from "$brand/utils";
import { Skeleton } from "$brand/starwind/skeleton";

/*
 * A skeleton for a run of stat cards: `count` outline cards in the grid
 * StatGrid draws, three lines each — the label, the number and the trend
 * line the cards land — so the real cards land where the skeletons stood.
 */

interface Props extends HTMLAttributes<"div"> {
  count?: number;
}

const { count = 4, class: className, ...rest } = Astro.props;

// The grid for each count, written out in full.
const columns: Record<number, string> = {
  2: "sm:grid-cols-2",
  3: "sm:grid-cols-3",
  4: "sm:grid-cols-4",
};
---

<div
  data-slot="skeleton-stats"
  class={cn("grid grid-cols-2 gap-3", columns[count] ?? columns[4], className)}
  aria-hidden="true"
  {...rest}
>
  {
    Array.from({ length: count }).map(() => (
      <div class="flex flex-col gap-2.5 rounded-xl border border-border px-4 py-4">
        <Skeleton class="h-5 w-24" />
        <Skeleton class="h-8 w-20" />
        <div class="flex flex-wrap items-center gap-x-1.5 gap-y-0.5">
          <Skeleton class="h-4 w-14" />
          <Skeleton class="h-4 w-20" />
        </div>
      </div>
    ))
  }
</div>
