---
import { ArrowRight } from "@lucide/astro";
import { cn } from "$brand/utils";
import { Button } from "$brand/starwind/button";
import Container from "$brand/blocks/site/container.astro";
import Wordmark from "$brand/components/wordmark.astro";
import CommandBox from "$brand/components/command-box.astro";
import VoxelField from "$brand/components/voxel-field.astro";
import FooterColumns, { type FooterColumn } from "$brand/components/footer-columns.astro";
import FooterFamily from "$brand/components/footer-family.astro";
import FooterSocials from "$brand/components/footer-socials.astro";
import { footerLabel } from "$brand/components/footer-ui";

/*
 * A footer that opens on a full-width voxel field rising into an oxide ridge
 * under the cursor, carrying the last call to install: an eyebrow, the
 * closing line, the command and two buttons over a reading layer. The
 * columns, the family and icon links follow below.
 */

interface Props {
  site: string;
  /** After the wordmark in small type: "by freeoxide". */
  maker?: string;
  /** Where the wordmark links to. */
  href?: string;
  tagline: string;
  columns: FooterColumn[];
  /** A mono oxide label above the closing line: the release. */
  eyebrow?: string;
  /** The closing line over the field, with its main button and an optional outline one. */
  cta?: { title: string; primary: { label: string; href: string }; secondary?: { label: string; href: string } };
  /** The install command, with a copy button. */
  command?: string;
  /** Icon links: GitHub, X, … */
  socials?: { label: string; href: string }[];
  legal?: string;
  class?: string;
}

const { site, maker, href = "/", tagline, columns, eyebrow, cta, command, socials = [], legal = "© 2026 hmziq", class: className } = Astro.props;
---

<footer data-slot="voxel-footer" class={cn("relative border-t border-border bg-background text-foreground", className)}>
  <div data-pointer-host class="relative isolate overflow-hidden border-b border-border">
    <VoxelField size={22} reach={150} lift={72} quiet class="-z-20" />
    <div aria-hidden="true" class="absolute inset-0 -z-10 bg-[linear-gradient(to_bottom,color-mix(in_oklab,var(--background)_90%,transparent),color-mix(in_oklab,var(--background)_55%,transparent))] lg:bg-[linear-gradient(to_right,var(--background)_0%,color-mix(in_oklab,var(--background)_90%,transparent)_36%,transparent_68%)]"></div>
    <Container size="wide" class="flex min-h-[clamp(320px,30vw,420px)] flex-col justify-center gap-6 py-16">
      {eyebrow && <p class={footerLabel}>{eyebrow}</p>}
      {cta && <h2 class="max-w-[14ch] text-[clamp(2.25rem,5vw,4rem)] leading-[1] font-medium tracking-[-0.035em] text-balance">{cta.title}</h2>}
      {command && <CommandBox command={command} class="w-full max-w-xl bg-background" />}
      {
        cta && (
          <div class="flex flex-wrap gap-3">
            <Button href={cta.primary.href} size="lg">{cta.primary.label}<ArrowRight class="lucide" data-icon="inline-end" /></Button>
            {cta.secondary && <Button href={cta.secondary.href} size="lg" variant="outline">{cta.secondary.label}</Button>}
          </div>
        )
      }
    </Container>
  </div>

  <Container size="wide" class="pt-14">
    <div class="grid gap-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,2fr)]">
      <div class="flex flex-col gap-5">
        <a href={href} class="inline-flex items-baseline gap-2 self-start rounded-sm text-2xl outline-none focus-visible:ring-3 focus-visible:ring-ring/50">
          <Wordmark name={site} />
          {maker && <span class="text-base text-foreground/80">{maker}</span>}
        </a>
        <p class="max-w-[34ch] text-[17px] leading-snug">{tagline}</p>
      </div>
      <FooterColumns columns={columns} />
    </div>
    <FooterFamily site={site} class="mt-14 border-t border-border pt-8" />
    <div class="mt-12 flex flex-wrap items-center justify-between gap-x-6 gap-y-3 border-t border-border pt-6 pb-10 text-[13px]">
      <span class="text-muted-foreground">{legal}</span>
      {socials.length > 0 && <FooterSocials links={socials} />}
    </div>
  </Container>
</footer>
