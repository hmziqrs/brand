---
import { cn } from "$brand/utils";
import Container from "$brand/blocks/site/container.astro";
import AppMock from "$brand/components/app-mock.astro";
import CornerRings from "$brand/components/corner-rings.astro";
import SurfaceTile from "$brand/components/surface-tile.astro";
import SectionHead from "./section-head.astro";

/*
 * A bento of four surfaces a product or a studio ships to (a tall phone, a
 * wide desktop, then web and the terminal), each a SurfaceTile with a real
 * AppMock on its material, beside one oxide card with a status, a statement
 * and the card-actions slot. A SectionHead leads it on the wide Container.
 */

export type Surface = {
  title: string;
  body: string;
  /** The Tag on the tile: the kind of product. */
  tag?: string;
  /** The material the app stands on. */
  preset: string;
  mock: { kind: "phone" | "desktop" | "web" | "terminal"; title?: string };
  href?: string;
};

interface Props {
  kicker?: string;
  title: string;
  /** The part of the title in oxide. */
  accent?: string;
  lede?: string;
  /** md makes the head a part of a bigger section: smaller, an h3. */
  size?: "lg" | "md";
  /** Exactly four, in order: the tall one, the wide one, then two small ones. */
  surfaces: Surface[];
  /** The oxide card: a status line with a pulse, a statement and a line; its rings are drawn from `seed`. */
  card?: { status?: string; title: string; body?: string; seed?: string };
  /** The link for surfaces without their own. */
  href?: string;
  class?: string;
}

const { kicker, title, accent, lede, size = "lg", surfaces, card, href = "#", class: className } = Astro.props;
const place = [
  "sm:row-span-2 lg:col-start-1 lg:row-span-2 lg:row-start-1",
  "sm:col-span-1 lg:col-span-2 lg:col-start-2 lg:row-start-1",
  "lg:col-start-2 lg:row-start-2",
  "lg:col-start-3 lg:row-start-2",
];
const fit = { phone: "mx-auto max-w-[220px] bg-background", desktop: "mx-auto max-w-[440px] bg-background", web: "mx-auto max-w-[300px] bg-background", terminal: "mx-auto max-w-[300px]" };
const tiles = surfaces.slice(0, 4).map((s, i) => ({ s, i }));
---

<section data-slot="surface-bento" class={cn("py-24 sm:py-32", className)}>
  <Container size="wide">
    <SectionHead kicker={kicker} title={title} accent={accent} lede={lede} size={size} />
    <div class={cn("grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-4 lg:grid-rows-[repeat(2,minmax(19rem,auto))]", size === "md" ? "mt-10" : "mt-12 md:mt-16")}>
      {
        tiles.slice(0, 2).map(({ s, i }) => (
          <SurfaceTile href={s.href ?? href} preset={s.preset} title={s.title} body={s.body} tag={s.tag} class={place[i]}>
            <AppMock kind={s.mock.kind} title={s.mock.title} class={fit[s.mock.kind]} />
          </SurfaceTile>
        ))
      }
      {
        card && (
          <article class="band-orange relative isolate flex min-h-72 flex-col justify-between gap-8 overflow-hidden rounded-2xl p-6 sm:p-7 lg:col-start-4 lg:row-span-2 lg:row-start-1">
            <CornerRings seed={card.seed ?? card.title} color="var(--on-orange)" class="pointer-events-none -z-10 w-3/4 opacity-60 [&_circle]:[stroke-width:0.5]" />
            {card.status && (
              <p class="flex items-center gap-2 font-mono text-xs tracking-wide uppercase">
                <span class="size-2 rounded-full bg-current motion-safe:animate-pulse"></span>
                {card.status}
              </p>
            )}
            <div class="flex flex-col gap-5">
              <p class="text-[clamp(2.5rem,4vw,3.75rem)] leading-[0.92] font-medium tracking-[-0.05em]">{card.title}</p>
              {card.body && <p class="text-lg leading-snug">{card.body}</p>}
              {Astro.slots.has("card-actions") && <div class="flex flex-wrap gap-3"><slot name="card-actions" /></div>}
            </div>
          </article>
        )
      }
      {
        tiles.slice(2, 4).map(({ s, i }) => (
          <SurfaceTile href={s.href ?? href} preset={s.preset} title={s.title} body={s.body} tag={s.tag} class={place[i]}>
            <AppMock kind={s.mock.kind} title={s.mock.title} class={fit[s.mock.kind]} />
          </SurfaceTile>
        ))
      }
    </div>
  </Container>
</section>
