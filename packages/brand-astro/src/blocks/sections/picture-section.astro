---
import { cn } from "$brand/utils";
import Container from "$brand/blocks/site/container.astro";
import PictureGrid from "$brand/components/picture-grid.astro";
import type { PictureItem } from "$brand/components/picture-card.astro";
import SectionHead from "./section-head.astro";

/*
 * A section of picture cards: a SectionHead, then a PictureGrid, with filter
 * pills when `filter` is set, on the wide Container. For a body of work, a
 * set of starting points, a list of guides. Slots: actions (beside the lede)
 * and the default slot, which follows the grid.
 */

interface Props {
  kicker?: string;
  title: string;
  /** The part of the title in oxide. */
  accent?: string;
  lede?: string;
  items: PictureItem[];
  /** The link for items without their own. */
  href?: string;
  /** The filter pills' label for screen readers; set it to show them. */
  filter?: string;
  class?: string;
}

const { kicker, title, accent, lede, items, href = "#", filter, class: className } = Astro.props;
---

<section data-slot="picture-section" class={cn("py-24 sm:py-32", className)}>
  <Container size="wide">
    <SectionHead kicker={kicker} title={title} accent={accent} lede={lede}>
      {Astro.slots.has("actions") && <slot name="actions" slot="aside" />}
    </SectionHead>
    <PictureGrid items={items} href={href} filter={filter} class="mt-12 md:mt-16" />
    <slot />
  </Container>
</section>
