---
import { cn } from "$brand/utils";
import CommandBox from "$brand/components/command-box.astro";
import Container from "$brand/blocks/site/container.astro";
import AccentTitle from "./accent-title.astro";

/*
 * The hero for one tool or app: the words sell it, an install command gets
 * it, and the visual is the product working. split puts the words left and
 * the visual right; centered stacks them. A stage fills the whole width
 * behind it, with a reading layer of the page color behind the words (a fade
 * from the left for split, a soft oval for centered); contents sit in the
 * wide Container. Slots: eyebrow (above the title), actions (the buttons),
 * note (under the install command), visual (the product working) and stage
 * (a full-width background: MaterialWash, MaterialGrid, …).
 */

interface Props {
  title: string;
  /** The part of the title in oxide. */
  accent?: string;
  lede: string;
  /** The install command, with a copy button. */
  install?: string;
  /** A line above the install command. */
  installLabel?: string;
  layout?: "split" | "centered";
  class?: string;
}

const { title, accent, lede, install, installLabel, layout = "split", class: className } = Astro.props;
const centered = layout === "centered";
const stage = Astro.slots.has("stage");
---

<section data-slot="product-hero" data-layout={layout} data-pointer-host class={cn("relative isolate overflow-hidden", className)}>
  {
    stage && (
      <>
        <div class="absolute inset-0 -z-10">
          <slot name="stage" />
        </div>
        <div
          aria-hidden="true"
          data-slot="product-hero-reading"
          class={cn(
            "pointer-events-none absolute inset-0 -z-[5]",
            centered
              ? "bg-[radial-gradient(ellipse_46%_44%_at_50%_34%,color-mix(in_oklab,var(--background)_84%,transparent)_0%,color-mix(in_oklab,var(--background)_70%,transparent)_55%,transparent_100%)]"
              : "bg-[linear-gradient(to_right,color-mix(in_oklab,var(--background)_86%,transparent)_0%,color-mix(in_oklab,var(--background)_74%,transparent)_34%,color-mix(in_oklab,var(--background)_30%,transparent)_52%,transparent_64%)]",
          )}
        />
      </>
    )
  }
  <Container
    size="wide"
    class={cn(centered ? "pt-16 pb-16 lg:pt-20" : "grid grid-cols-1 items-center gap-12 py-16 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.08fr)] lg:gap-16 lg:py-28")}
  >
    <div class={cn("min-w-0", centered && "mx-auto flex max-w-[52rem] flex-col items-center text-center")}>
      {Astro.slots.has("eyebrow") && <div class="mb-7"><slot name="eyebrow" /></div>}
      <AccentTitle
        title={title}
        accent={accent}
        class={cn("font-semibold tracking-[-0.04em] text-foreground", stage && "[text-shadow:0_2px_40px_var(--background),0_0_14px_var(--background)]", centered ? "max-w-[18ch] text-[clamp(44px,6.4vw,84px)]" : "max-w-[13ch] text-[clamp(44px,5.8vw,80px)]", "leading-[0.98]")}
      />
      <p class={cn("mt-7 text-[clamp(18px,1.6vw,21px)] text-pretty text-foreground/90 [line-height:1.5]", stage && "text-foreground [text-shadow:0_1px_24px_var(--background),0_0_10px_var(--background)]", centered ? "max-w-[44rem]" : "max-w-[34rem]")}>{lede}</p>
      {Astro.slots.has("actions") && <div class={cn("mt-9 flex flex-wrap gap-3", centered && "justify-center")}><slot name="actions" /></div>}
      {
        install && (
          <div class={cn("mt-8 w-full max-w-[30rem]", centered && "mx-auto")}>
            {installLabel && <p class={cn("mb-2 text-sm font-medium text-foreground", centered && "text-center")}>{installLabel}</p>}
            <CommandBox command={install} class="bg-background text-left" />
          </div>
        )
      }
      {Astro.slots.has("note") && <div class={cn("mt-5", centered && "flex justify-center")}><slot name="note" /></div>}
    </div>
    {Astro.slots.has("visual") && <div class={cn("relative min-w-0", centered && "mx-auto mt-12 max-w-[1120px] lg:mt-14")}><slot name="visual" /></div>}
  </Container>
</section>
