---
import { cn } from "$brand/utils";
import Glass from "$brand/components/glass.astro";
import Container from "$brand/blocks/site/container.astro";
import AccentTitle from "./accent-title.astro";

/*
 * The hero for a studio, an initiative or a lab: one big statement over a
 * full-width stage that carries the identity. left sets the words on the
 * left, with a reading layer of the page color fading out behind them;
 * center centers them. `panel` puts the lede and buttons on smoke glass.
 * Contents sit in the wide Container; the stage keeps the pointer where the
 * words don't. Slots: eyebrow (above the title), wordmark (above the title,
 * in display oxide), heading (replaces the title: a ResolveTitle, a custom
 * h1), actions (the buttons), meta (under everything) and stage (a
 * full-width background: MaterialGrid, SceneStage, DiagonalHatch, RingField, …).
 */

interface Props {
  title: string;
  /** The part of the title in oxide. */
  accent?: string;
  lede: string;
  align?: "left" | "center";
  /** The lede and buttons on smoke glass, for busy stages. */
  panel?: boolean;
  /** A glow of the page color behind the title, for busy stages; on with `panel`. */
  scrim?: boolean;
  /** Classes for the title, after the defaults. */
  titleClass?: string;
  class?: string;
}

const { title, accent, lede, align = "left", panel = false, scrim, titleClass, class: className } = Astro.props;
const center = align === "center";
const stage = Astro.slots.has("stage");
const ledeClass = cn("text-[clamp(18px,1.7vw,22px)] text-pretty text-foreground [line-height:1.5]", center ? "mx-auto max-w-[40rem]" : "max-w-[36rem]");
const actionsClass = cn("mt-8 flex flex-wrap gap-3", center && "justify-center");
---

<section data-slot="brand-hero" data-align={align} data-pointer-host class={cn("relative isolate flex min-h-[min(88svh,820px)] flex-col justify-center overflow-hidden", className)}>
  {
    stage && (
      <>
        <div class="absolute inset-0 -z-10">
          <slot name="stage" />
        </div>
        {!center && (
          <div
            aria-hidden="true"
            data-slot="brand-hero-reading"
            class="pointer-events-none absolute inset-0 -z-[5] bg-[linear-gradient(to_right,color-mix(in_oklab,var(--background)_78%,transparent)_0%,color-mix(in_oklab,var(--background)_62%,transparent)_36%,color-mix(in_oklab,var(--background)_22%,transparent)_56%,transparent_68%)]"
          />
        )}
      </>
    )
  }
  <Container size="wide" class={cn("pointer-events-none relative py-24 lg:py-32 [&>*]:pointer-events-auto", center && "flex flex-col items-center text-center")}>
    {Astro.slots.has("eyebrow") && <div class="mb-7"><slot name="eyebrow" /></div>}
    {Astro.slots.has("wordmark") && <div data-display class={cn("mb-8 w-full", center && "flex justify-center")}><slot name="wordmark" /></div>}
    {
      Astro.slots.has("heading") ? (
        <slot name="heading" />
      ) : (
        <AccentTitle
          title={title}
          accent={accent}
          class={cn(
            "font-semibold tracking-[-0.045em] text-foreground",
            (scrim ?? panel) && "[text-shadow:0_2px_40px_var(--background),0_0_12px_var(--background)]",
            center ? "max-w-[15ch] text-[clamp(44px,6.8vw,100px)]" : "max-w-[14ch] text-[clamp(48px,8.4vw,132px)]",
            "leading-[0.95]",
            titleClass,
          )}
        />
      )
    }
    {
      panel ? (
        <Glass variant="smoke" class={cn("mt-10 rounded-2xl p-6 sm:p-7", center ? "mx-auto max-w-[44rem]" : "max-w-[40rem]")}>
          <p class={ledeClass}>{lede}</p>
          {Astro.slots.has("actions") && <div class={actionsClass}><slot name="actions" /></div>}
        </Glass>
      ) : (
        <div class="mt-8">
          <p class={ledeClass}>{lede}</p>
          {Astro.slots.has("actions") && <div class={actionsClass}><slot name="actions" /></div>}
        </div>
      )
    }
    {Astro.slots.has("meta") && <div class="mt-10 w-full"><slot name="meta" /></div>}
  </Container>
</section>
