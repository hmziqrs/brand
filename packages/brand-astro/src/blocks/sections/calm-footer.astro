---
import { cn } from "$brand/utils";
import { Button } from "$brand/starwind/button";
import { Input } from "$brand/starwind/input";
import Container from "$brand/blocks/site/container.astro";
import Wordmark from "$brand/components/wordmark.astro";
import DiagonalHatch from "$brand/components/diagonal-hatch.astro";
import FooterColumns, { type FooterColumn } from "$brand/components/footer-columns.astro";
import FooterFamily from "$brand/components/footer-family.astro";
import FooterSocials from "$brand/components/footer-socials.astro";
import { footerLink } from "$brand/components/footer-ui";

/*
 * A quiet footer for reading: the wordmark, one line and an email box, the
 * columns, the family, icon links and an optional text link, over a faint
 * hatch that bends toward the cursor. It never competes with the text above
 * it.
 */

interface Props {
  site: string;
  /** After the wordmark in small type: "by hmziq". */
  maker?: string;
  /** Where the wordmark links to. */
  href?: string;
  tagline: string;
  columns: FooterColumn[];
  /** The line under the email box. */
  note?: string;
  /** The feed's address: adds "Or follow the RSS feed." to the note. */
  rss?: string;
  /** Icon links: GitHub, X, LinkedIn, … */
  socials?: { label: string; href: string }[];
  /** A text link after the icons: "Edit this page on GitHub". */
  edit?: { label: string; href: string };
  legal?: string;
  class?: string;
}

const { site, maker, href = "/", tagline, columns, note = "One email when a post goes up, nothing else.", rss, socials = [], edit, legal = "© 2026 hmziq", class: className } = Astro.props;
const field = `${site}-footer-email`;
---

<footer data-slot="calm-footer" data-pointer-host class={cn("relative isolate overflow-hidden border-t border-border bg-background text-foreground", className)}>
  <DiagonalHatch class="-z-10 opacity-35" />
  <Container size="wide" class="pt-14 pb-10 sm:pt-16">
    <div class="grid gap-12 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,2fr)]">
      <div class="flex max-w-md flex-col gap-5">
        <a href={href} class="inline-flex items-baseline gap-2 self-start rounded-sm text-xl outline-none focus-visible:ring-3 focus-visible:ring-ring/50">
          <Wordmark name={site} />
          {maker && <span class="text-[0.8em] text-foreground/80">{maker}</span>}
        </a>
        <p class="text-[15px] leading-relaxed">{tagline}</p>
        <form class="flex gap-2" onsubmit="return false">
          <label for={field} class="sr-only">Email</label>
          <Input id={field} type="email" placeholder="you@example.com" autocomplete="email" class="h-9 min-w-0 px-2.5 py-1 text-base outline-none md:text-sm" />
          <Button type="submit" variant="outline">Subscribe</Button>
        </form>
        <p class="text-[13px] text-muted-foreground">{note}{rss && <Fragment>{" Or follow the "}<a href={rss} class={cn(footerLink, "text-foreground decoration-foreground/40")}>RSS feed</a>.</Fragment>}</p>
      </div>
      <FooterColumns columns={columns} />
    </div>

    <FooterFamily site={site} class="mt-14 border-t border-border pt-8" />

    <div class="mt-12 flex flex-wrap items-center justify-between gap-x-6 gap-y-3 border-t border-border pt-6 text-[13px]">
      <span class="text-muted-foreground">{legal}</span>
      <div class="flex flex-wrap items-center gap-x-5 gap-y-2">
        {socials.length > 0 && <FooterSocials links={socials} />}
        {edit && <a href={edit.href} class={footerLink}>{edit.label}</a>}
      </div>
    </div>
  </Container>
</footer>
