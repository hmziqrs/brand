---
import { cn } from "$brand/utils";
import PastReleases from "./past-releases.astro";
import type { Release } from "./types";

/*
 * The changelog's timeline: one release per line, an orange ring lined up
 * with each version heading and a line joining them down the page. Newest
 * first. The latest release usually stands apart above it, so it is not in
 * the timeline's list — drop it from what you pass, or let `skip` take it.
 * `rail` is the long page's timeline instead: thin rings, the latest one
 * filled, and a line that fills with oxide down to where you read, each
 * ring it passes turning oxide. A function child, `(release, index) =>
 * markup`, sets what each release shows; PastReleases when left out. With
 * `rail`, each line is a `[data-release]` a changelog block can narrow.
 */

interface Props {
  releases: Release[];
  /** How many releases to skip off the front, for the one shown above. */
  skip?: number;
  /** Thin rings on a line that fills as you scroll. */
  rail?: boolean;
  /** The version whose ring is filled, with `rail`. */
  latest?: string;
  class?: string;
}

const { releases, skip = 0, rail = false, latest, class: className } = Astro.props;

const list = releases.slice(skip);
const custom = Astro.slots.has("default");
const items = custom ? await Promise.all(list.map((release, i) => Astro.slots.render("default", [release, i]))) : [];
---

{
  rail ? (
    <ol data-slot="release-timeline" data-variant="rail" class={cn("relative", className)}>
      <span aria-hidden="true" data-rail="track" class="absolute left-[calc(0.40625rem-0.5px)] w-px bg-border" style="top:0px;height:0px" />
      <span aria-hidden="true" data-rail="fill" class="absolute left-[calc(0.40625rem-0.5px)] w-px bg-primary" style="top:0px;height:0px" />
      {list.map((release, i) => (
        <li data-release={release.v} class="group/release relative pb-16 pl-9 last:pb-0 data-[last]:pb-0 md:pb-20 md:pl-12">
          <span
            data-node
            aria-hidden="true"
            class={cn(
              "absolute top-[0.42rem] left-0 z-10 size-3.25 rounded-full border bg-background transition-colors duration-200 motion-reduce:transition-none",
              release.v === latest ? "border-primary bg-primary" : "border-foreground/35 data-[passed]:border-primary",
            )}
          />
          {custom ? <Fragment set:html={items[i]} /> : <PastReleases release={release} />}
        </li>
      ))}
    </ol>
  ) : (
    <ol data-slot="release-timeline" class={cn("flex flex-col", className)}>
      {list.map((release, i) => (
        <li
          class={cn(
            "relative pb-11 pl-9 last:pb-0",
            "before:absolute before:top-[0.42rem] before:left-0 before:z-10 before:size-3.25 before:rounded-full before:border-[1.75px] before:border-primary before:bg-background",
            i < list.length - 1 && "after:absolute after:top-[1.45rem] after:bottom-1 after:left-[calc(0.4rem-0.5px)] after:w-px after:bg-border",
          )}
        >
          {custom ? <Fragment set:html={items[i]} /> : <PastReleases release={release} />}
        </li>
      ))}
    </ol>
  )
}

<script>
  const seen = new WeakSet<HTMLElement>();
  let raf = 0;

  function measure(ol: HTMLElement) {
    const nodes = [...ol.querySelectorAll<HTMLElement>("[data-node]")].filter((n) => n.getClientRects().length > 0);
    if (!nodes.length) return;
    const box = ol.getBoundingClientRect();
    const ys = nodes.map((n) => {
      const r = n.getBoundingClientRect();
      return r.top + r.height / 2 - box.top;
    });
    const first = ys[0];
    const last = ys[ys.length - 1];
    const reading = window.innerHeight * 0.45 - box.top;
    const track = ol.querySelector<HTMLElement>("[data-rail='track']");
    const fill = ol.querySelector<HTMLElement>("[data-rail='fill']");
    for (const el of [track, fill]) if (el) el.style.top = `${first}px`;
    if (track) track.style.height = `${Math.max(0, last - first)}px`;
    if (fill) fill.style.height = `${Math.max(0, Math.min(last - first, reading - first))}px`;
    nodes.forEach((n, i) => n.toggleAttribute("data-passed", ys[i] <= reading));
  }

  const rails = () => document.querySelectorAll<HTMLElement>("[data-slot='release-timeline'][data-variant='rail']");
  const kick = () => {
    if (!raf)
      raf = requestAnimationFrame(() => {
        raf = 0;
        rails().forEach(measure);
      });
  };
  const ro = new ResizeObserver(kick);

  function wire() {
    for (const ol of rails()) {
      if (seen.has(ol)) continue;
      seen.add(ol);
      ro.observe(ol);
    }
    kick();
  }

  window.addEventListener("scroll", kick, { passive: true });
  window.addEventListener("resize", kick);
  document.addEventListener("astro:page-load", wire);
  wire();
</script>
