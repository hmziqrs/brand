---
import SiteLayout from "$brand/blocks/site/site-layout.astro";
import type { Props as SiteHeadProps } from "$brand/blocks/site/site-head.astro";

/*
 * The blog's shell: the site shell set up for reading — the wordmark with
 * "by hmziq" after it, the posts nav, a Subscribe button, the inner-page
 * rhythm, and no padding under the main column so the newsletter band
 * closes the page flush.
 */

type Head = Omit<SiteHeadProps, "site"> & { site?: string };

interface Props {
  /** The nav item for the page you're on. */
  current?: string;
  /** The page's head, rendered by SiteHead. */
  head?: Head;
  /** The page's theme class. Dark by default; the app's toggle rewrites it before first paint. */
  theme?: string;
}

const { current, head, theme = "dark" } = Astro.props;
---

<SiteLayout site="Blog" maker="by hmziq" nav={["Posts", "Tags", "About"]} current={current} cta={{ label: "Subscribe" }} layout="page" mainClassName="pb-0" head={head} theme={theme}>
  {/* Slots pass through as plain elements, never behind a conditional: Astro
      registers a named slot when it compiles the template, so a
      `{Astro.slots.has(…) && <slot … />}` forward makes the slot look passed
      to SiteLayout even when no page sent one, and its defaults — the
      footer's "More from hmziq" row, the legal line — never rendered. The
      blog pages pass `head` (the theme's pre-paint baseline) and `extra`
      (the theme toggle); anything else a page doesn't pass doesn't render. */}
  <slot name="head" slot="head" />
  <slot name="extra" slot="extra" />
  <slot />
</SiteLayout>
