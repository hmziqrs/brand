---
import { ArrowRight } from "@lucide/astro";
import { cn } from "$brand/utils";
import OutlineCard from "$brand/blocks/site/outline-card.astro";
import CornerRings from "$brand/components/corner-rings.astro";
import type { Tone } from "@hmziq/brand-core/tones";
import PostMeta from "./post-meta.astro";
import type { PostItem } from "./types";

/*
 * One post in a list: its topic and date, its title, one line of summary and
 * a Read link. The newest post is `featured`: its own rings in its topic's
 * color, and the larger type the lab's blog index gives it. The wrapper (not
 * the card) carries what a page filters on, so it works whether the card is
 * linked or not.
 */

interface Props {
  post: PostItem;
  /** The newest post: rings in the corner and the larger title. */
  featured?: boolean;
  /** The topic's color, for the tag and the featured card's rings. */
  tone?: (topic: string) => Tone | undefined;
  class?: string;
}

const { post, featured = false, tone, class: className } = Astro.props;

const topicTone = post.topic !== undefined ? tone?.(post.topic) : undefined;
---

<article
  data-post
  data-topic={post.topic}
  data-search={`${post.title} ${post.summary ?? ""}`.toLowerCase()}
  class={cn(featured && "mb-6", className)}
>
  <OutlineCard href={post.href} class={cn(featured && "p-6 sm:p-10")}>
    {featured && <CornerRings seed={post.title} color={topicTone ? `var(--${topicTone})` : undefined} quiet class="w-[38%]" />}
    <PostMeta post={post} tone={tone} />
    <h2 class={cn("relative", featured ? "max-w-xl text-2xl leading-[1.15] font-medium tracking-[-0.03em] sm:text-[2.1rem]" : "text-lg leading-[1.35] font-medium")}>{post.title}</h2>
    {post.summary && <p class={cn("relative", featured ? "max-w-[34rem] text-base leading-relaxed text-muted-foreground" : "text-[0.9rem] leading-relaxed text-muted-foreground")}>{post.summary}</p>}
    <span class="relative mt-auto inline-flex items-center gap-1.5 pt-2 text-[0.8125rem] font-medium text-primary">
      Read the post
      <ArrowRight class="size-3.75" />
    </span>
  </OutlineCard>
</article>
