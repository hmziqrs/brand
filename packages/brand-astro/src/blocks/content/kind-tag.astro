---
import Tag from "$brand/components/tag.astro";
import type { Tone } from "@hmziq/brand-core/tones";
import { kindTone, type ChangeKind } from "./types";

/*
 * A release's kind of change as a tag: Added, Changed, Fixed… Each kind
 * keeps one color on every page. The lab's colors are the default; pass
 * `tone` to pick your own.
 */

interface Props {
  kind: ChangeKind;
  /** How many changes of this kind the release has, shown after the word. */
  count?: number;
  tone?: Tone;
}

const { kind, count, tone } = Astro.props;
---

<Tag tone={tone ?? kindTone[kind]}>
  {kind}
  {count !== undefined && ` ${count}`}
</Tag>
