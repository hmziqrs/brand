---
import ReleaseHead from "./release-head.astro";
import ReleaseNotes from "./release-notes.astro";
import type { ChangeSpots, Release } from "./types";

/*
 * One past release, folded: its head, its title if it has one, its first
 * change, and the button that shows the rest. The latest release gets the
 * whole list instead — pass it ReleaseNotes directly, or turn `fold` off.
 */

interface Props {
  release: Release;
  /** Folded to its first change; off shows every change, grouped by kind. */
  fold?: boolean;
  /** The folded rest, shown. */
  open?: boolean;
  /** h2 for the latest release. */
  level?: 2 | 3;
  /** The date written out ("Nov 3, 2026"). */
  longDate?: boolean;
  /** The parts of the picture the changes name (ReleaseNotes). */
  spots?: ChangeSpots;
  /** The release before a filter narrowed it. */
  full?: Release;
}

const { release, fold = true, open = false, level = 3, longDate = false, spots, full } = Astro.props;
---

<ReleaseHead release={release} level={level} longDate={longDate} />
{release.title && <p class="mt-3 text-[1.375rem] leading-snug font-medium tracking-[-0.02em] text-balance text-foreground md:text-[1.625rem]">{release.title}</p>}
<ReleaseNotes release={release} variant={fold ? "summary" : "grouped"} open={open} spots={spots} full={full} />
