---
import CtaBand from "$brand/blocks/site/cta-band.astro";
import { Input } from "$brand/starwind/input";
import { Button } from "$brand/starwind/button";

/*
 * The newsletter sign-up on the orange band, at the end of every post and
 * the post list. The form posts to the page's own action — the page (or the
 * site behind it) receives it; no mailing service is built in, and none is
 * wired up here. Give the field a `name` the receiving end reads.
 */

interface Props {
  title?: string;
  body?: string;
  /** Where the form posts. The page's own address by default. */
  action?: string;
  /** The field's name on the way out. */
  name?: string;
  /** The button's words. */
  button?: string;
}

const {
  title = "Get new posts by email",
  body = "Get notified when new posts are published. No spam, unsubscribe anytime.",
  action,
  name = "email",
  button = "Subscribe",
} = Astro.props;
---

<CtaBand compact title={title}>
  <Fragment slot="body">{body}</Fragment>
  <form slot="actions" method="post" action={action} class="flex w-full max-w-md flex-wrap items-center gap-2">
    <label for="newsletter-email" class="sr-only">
      Email address
    </label>
    <Input id="newsletter-email" type="email" name={name} autocomplete="email" placeholder="you@example.com" class="h-10 min-w-48 flex-1 shadow-none dark:bg-transparent" />
    <Button type="submit" size="lg" class="px-5">
      {button}
    </Button>
  </form>
</CtaBand>
