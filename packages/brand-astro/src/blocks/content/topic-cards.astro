---
import { cn } from "$brand/utils";
import Tag from "$brand/components/tag.astro";
import type { TopicShelf, TopicTone } from "./types";

/*
 * A blog's topics as cards that filter its posts: each one's Tag, how many
 * posts and minutes of reading it holds, and its newest title. The picked
 * one rings in oxide and says Showing. Picking a card picks its topic, and
 * picking it again clears it back to `all`; either way a `topic-change`
 * event bubbles with the value, the one TopicChips sends.
 */

interface Props {
  items: TopicShelf[];
  /** The picked topic. */
  value?: string;
  /** The value a cleared pick sends. */
  all?: string;
  /** The topic's color, for its Tag. */
  tone?: TopicTone;
  class?: string;
}

const { items, value, all = "All", tone, class: className } = Astro.props;
---

<div data-slot="topic-cards" data-all={all} data-value={value} class={cn("grid gap-4 md:grid-cols-3", className)}>
  {
    items.map((s) => (
      <button
        type="button"
        data-topic={s.topic}
        aria-pressed={value === s.topic ? "true" : "false"}
        class="group flex min-h-52 flex-col gap-5 rounded-2xl p-6 text-left ring-1 ring-foreground/10 transition-shadow outline-none hover:ring-primary/50 focus-visible:ring-3 focus-visible:ring-ring/50 aria-pressed:ring-primary/70 motion-reduce:transition-none"
      >
        <span class="flex items-center justify-between gap-3">
          <Tag tone={tone?.(s.topic)}>{s.topic}</Tag>
          <span data-showing hidden={value !== s.topic} class="font-mono text-[11px] tracking-[0.14em] text-primary uppercase">Showing</span>
        </span>
        <span class="mt-auto flex items-baseline gap-2.5">
          <span class="text-6xl leading-none font-medium tracking-[-0.05em] text-foreground tabular-nums">{s.count}</span>
          <span class="text-sm text-foreground/75">{`${s.count === 1 ? "post" : "posts"}${s.minutes === undefined ? "" : ` · ${s.minutes} min of reading`}`}</span>
        </span>
        {s.latest && <span class="line-clamp-2 min-h-[2.6em] text-[0.9375rem] leading-[1.3] text-foreground/85">Latest: {s.latest}</span>}
      </button>
    ))
  }
</div>

<script>
  function set(root: HTMLElement, value: string) {
    root.dataset.value = value;
    for (const b of root.querySelectorAll<HTMLElement>("button[data-topic]")) {
      const on = b.dataset.topic === value;
      b.setAttribute("aria-pressed", String(on));
      b.querySelector<HTMLElement>("[data-showing]")?.toggleAttribute("hidden", !on);
    }
  }

  document.addEventListener("click", (event) => {
    const button = (event.target as Element | null)?.closest<HTMLElement>("[data-slot='topic-cards'] button[data-topic]");
    const root = button?.closest<HTMLElement>("[data-slot='topic-cards']");
    if (!button || !root) return;
    const value = root.dataset.value === button.dataset.topic ? (root.dataset.all ?? "All") : (button.dataset.topic ?? "");
    set(root, value);
    root.dispatchEvent(new CustomEvent("topic-change", { detail: { value }, bubbles: true }));
  });
</script>
