---
import { cn } from "$brand/utils";
import Container from "./container.astro";
import BandArcs from "$brand/components/band-arcs.astro";

/*
 * The closing band: full width, in orange, with the band arcs on the right.
 * `band-orange` (theme.css) repaints everything inside it, buttons included.
 */

interface Props {
  title: string;
  /** A smaller title, for a band that isn't the page's last word (a newsletter under a post). */
  compact?: boolean;
}

const { title, compact } = Astro.props;
---

<section class="band-orange relative overflow-hidden">
  <BandArcs />
  <Container class="relative flex flex-col gap-7 py-16 md:flex-row md:items-end md:justify-between md:gap-12 md:py-24">
    <div class="flex max-w-xl flex-col gap-4">
      <h2 class={cn("font-medium text-balance", compact ? "text-[1.6rem] tracking-[-0.03em] md:text-4xl" : "text-4xl leading-[1.02] tracking-[-0.04em] md:text-[3.25rem]")}>{title}</h2>
      <p class="text-[1.0625rem] leading-relaxed text-muted-foreground">
        <slot name="body" />
      </p>
    </div>
    <div class="flex shrink-0 flex-wrap gap-3">
      <slot name="actions" />
    </div>
  </Container>
</section>
