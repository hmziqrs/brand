---
import { cn } from "$brand/utils";
import Container from "./container.astro";
import HeroTitle from "./hero-title.astro";
import HeroLede from "./hero-lede.astro";
import HeroActions from "./hero-actions.astro";
import HeroNotes from "./hero-notes.astro";

interface Props {
  /** "wide" gives a product beside the words more room than the words, from lg up. */
  asideSize?: "half" | "wide";
  class?: string;
}

const { asideSize = "half", class: className } = Astro.props;

const hasAside = Astro.slots.has("aside");
const wide = hasAside && asideSize === "wide";
---

<Container class={cn("grid items-center gap-10 md:gap-12", hasAside && !wide && "md:grid-cols-2", wide && "lg:grid-cols-[minmax(0,0.85fr)_minmax(0,1.15fr)]", className)}>
  <div class="flex max-w-xl flex-col gap-6">
    {Astro.slots.has("kicker") && <p class="-mb-2 text-[0.8125rem] text-muted-foreground"><slot name="kicker" /></p>}
    <HeroTitle size={wide ? "compact" : "default"}><slot name="title" /></HeroTitle>
    <HeroLede><slot name="lede" /></HeroLede>
    {Astro.slots.has("actions") && <HeroActions><slot name="actions" /></HeroActions>}
    {Astro.slots.has("note") && <HeroNotes><slot name="note" /></HeroNotes>}
  </div>
  {hasAside && <div class="min-w-0"><slot name="aside" /></div>}
  {Astro.slots.has("below") && <div class="mt-2 min-w-0 md:col-span-full"><slot name="below" /></div>}
</Container>
