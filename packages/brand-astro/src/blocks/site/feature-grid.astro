---
import { cn } from "$brand/utils";
import type { AstroPiece } from "$brand/utils";
import IconTile from "$brand/components/icon-tile.astro";
import FeatureIcon from "./feature-icon.astro";

type Feature = { icon?: AstroPiece; title: string; body: string };

interface Props {
  items: Feature[];
  columns?: 2 | 3;
}

const { items, columns = 3 } = Astro.props;
---

<div class={cn("grid gap-x-10 gap-y-10 sm:grid-cols-2", columns === 3 && "lg:grid-cols-3")}>
  {
    items.map((f) => (
      <div class="flex flex-col gap-3">
        {f.icon && (
          <IconTile>
            <FeatureIcon icon={f.icon} />
          </IconTile>
        )}
        <h3 class="font-medium">{f.title}</h3>
        <p class="text-sm leading-relaxed text-muted-foreground">{f.body}</p>
      </div>
    ))
  }
</div>
