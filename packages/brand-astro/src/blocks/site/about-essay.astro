---
import { ArrowUpRight } from "@lucide/astro";
import { cn } from "$brand/utils";
import Container from "./container.astro";
import ButtonLink from "./button-link.astro";
import SectionHead from "$brand/blocks/sections/section-head.astro";
import CommitmentCards from "$brand/blocks/sections/commitment-cards.astro";
import MaterialGrid from "$brand/components/material-grid.astro";
import Glass from "$brand/components/glass.astro";
import PictureCard from "$brand/components/picture-card.astro";
import BrandIcon from "$brand/components/brand-icon.astro";
import ExperienceRail from "$brand/components/experience-rail.astro";
import type { AboutEssayData } from "./company-types";

/*
 * The about page as an essay: the hover-grid material across the full width
 * behind the headline, with the lede on frosted glass; what the studio
 * believes as big paragraphs beside a sticky title; the commitments as
 * separate cards; the stack as picture cards with line drawings; and the
 * person with a rail of their years. Under the site's own header and footer.
 */

interface Props {
  data: AboutEssayData;
  /** Where the stack cards and "See the code" go. */
  href?: string;
  class?: string;
}

const { data, href = "#", class: className } = Astro.props;
const lead = data.title.slice(0, data.title.indexOf(data.accent));
const b = data.believe;
const w = data.who;
const initials = data.person.name.split(" ").map((p) => p[0]).join("").slice(0, 2);
---

<div data-slot="about-essay" class={cn("pb-24 md:pb-32", className)}>
  <section data-pointer-host class="relative isolate overflow-hidden border-b border-border">
    <MaterialGrid />
    <Container size="wide" class="relative py-24 md:py-32 lg:py-40">
      <Glass variant="clear" as="span" class="inline-flex rounded-full px-3 py-1.5 font-mono text-xs tracking-[0.14em] text-primary uppercase">{data.kicker}</Glass>
      <h1 class="mt-6 max-w-[11ch] text-[clamp(3.25rem,8.4vw,8.25rem)] leading-[0.9] font-semibold tracking-[-0.05em] text-foreground [text-shadow:0_2px_40px_var(--background),0_0_14px_var(--background)]">{lead}<span class="text-primary">{data.accent}</span></h1>
      <Glass class="mt-12 max-w-[40rem] rounded-2xl p-6 sm:p-7">
        <p class="text-[clamp(1.125rem,1.6vw,1.375rem)] leading-snug text-pretty text-foreground">{data.lede}</p>
      </Glass>
    </Container>
  </section>

  <Container size="wide" class="mt-24 grid gap-10 md:mt-32 lg:grid-cols-[minmax(0,0.85fr)_minmax(0,1.15fr)] lg:gap-16">
    <SectionHead kicker={b.kicker} title={b.title} layout="stack" titleClass="max-w-[13ch]" class="lg:sticky lg:top-[calc(var(--company-top,0px)+2rem)] lg:self-start" />
    <div class="flex min-w-0 flex-col gap-8 text-[clamp(1.25rem,1.9vw,1.625rem)] leading-[1.4] tracking-[-0.01em] text-foreground">
      <p>{b.lead.before}<span class="font-medium text-primary">{b.lead.hit}</span>{b.lead.after}</p>
      {b.paragraphs.map((text) => <p>{text}</p>)}
    </div>
  </Container>

  <Container size="wide" class="mt-28 md:mt-40">
    <CommitmentCards data={data.commitments} />
  </Container>

  <Container size="wide" class="mt-28 md:mt-40">
    <section data-slot="stack-cards">
      <SectionHead kicker={data.stack.kicker} title={data.stack.title} lede={data.stack.aside} />
      <div class="mt-12 grid gap-x-6 gap-y-12 sm:grid-cols-2 lg:grid-cols-4">
        {data.stack.items.map((d) => <PictureCard href={href} art={d.art} tag={`${d.n} / ${d.name}`} title={d.title} dek={d.dek} meta={d.tools.join(" · ")} as="h3" />)}
      </div>
      <p class="mt-12 max-w-[46rem] text-lg leading-snug text-foreground/85">{data.stack.foot}</p>
    </section>
  </Container>

  <Container size="wide" class="mt-28 md:mt-40">
    <section data-slot="who-section">
      <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] lg:items-end lg:gap-16">
        <SectionHead kicker={w.kicker} title={w.title} layout="stack" titleClass="max-w-[14ch]" />
        <div class="flex min-w-0 flex-col gap-6">
          <p class="text-[clamp(1.125rem,1.6vw,1.375rem)] leading-snug text-foreground">{w.body}</p>
          <div class="flex flex-wrap gap-3">
            <ButtonLink href={href} variant="outline">{w.links.work}</ButtonLink>
            <ButtonLink href={data.person.cv} variant="outline" target="_blank" rel="noreferrer">{w.links.cv}<ArrowUpRight data-icon="inline-end" /></ButtonLink>
          </div>
        </div>
      </div>
      <div class="mt-16 grid gap-4 lg:grid-cols-[minmax(0,1fr)_minmax(0,3fr)]">
        <article data-slot="person-card" class="flex flex-col gap-4 rounded-xl p-6 ring-1 ring-foreground/10 lg:self-start">
          <span class="grid size-14 place-items-center rounded-full text-sm font-medium uppercase ring-1 ring-foreground/15">{initials}</span>
          <div class="flex flex-col gap-0.5">
            <h3 class="font-medium">{data.person.name}</h3>
            <p class="text-sm text-muted-foreground">{data.person.role} · {data.person.years}</p>
          </div>
          <p class="text-sm leading-relaxed text-muted-foreground">{w.bio}</p>
          <div class="mt-auto flex gap-1">
            {
              (data.person.links ?? []).map((l) => (
                <a href={l.href} aria-label={`${data.person.name} on ${l.label}`} class="grid size-8 place-items-center rounded-md text-muted-foreground transition-colors outline-none hover:bg-foreground/8 hover:text-foreground focus-visible:ring-3 focus-visible:ring-ring/50">
                  <BrandIcon icon={l.icon} class="size-4" />
                </a>
              ))
            }
          </div>
        </article>
        <ExperienceRail roles={w.roles} kicker={w.rail.kicker} class="min-w-0 lg:pl-6" />
      </div>
    </section>
  </Container>
</div>
