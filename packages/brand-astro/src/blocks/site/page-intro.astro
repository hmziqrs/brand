---
import { cn } from "$brand/utils";

/* The top of an inner page: a small grey word, the title and one paragraph. */

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div class={cn("flex max-w-xl flex-col gap-6", className)}>
  {Astro.slots.has("kicker") && <p class="-mb-2 text-[0.8125rem] text-muted-foreground"><slot name="kicker" /></p>}
  <h1 class="text-[2.4rem] leading-[1.02] font-medium tracking-[-0.035em] text-balance sm:text-5xl lg:text-[3.6rem]"><slot name="title" /></h1>
  {Astro.slots.has("lede") && <p class="max-w-[34rem] text-lg leading-relaxed text-muted-foreground"><slot name="lede" /></p>}
  <slot />
</div>
