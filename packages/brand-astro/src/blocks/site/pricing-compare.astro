---
import { Check, Minus } from "@lucide/astro";
import { cn } from "$brand/utils";
import { Switch } from "$brand/starwind/switch";
import Segmented from "$brand/components/segmented.astro";
import SectionHead from "$brand/blocks/sections/section-head.astro";
import ButtonLink from "./button-link.astro";
import type { PricingCell, PricingCompareData, PricingTier } from "./pricing-types";

interface Props {
  tiers: PricingTier[];
  compare: PricingCompareData;
  /** Which billing mode's prices the plan headers show first: an index into the tier's lists. Every mode is rendered; the page's switch shows the one it asks for. */
  mode?: number;
  href?: string;
  /** The id of the differences switch; give each table on a page its own. */
  id?: string;
  class?: string;
}

const { tiers, compare, mode = 0, href = "#", id = "pricing-only", class: className } = Astro.props;

const pick = Math.max(0, tiers.findIndex((t) => t.pick));
const cols = `minmax(0,1.45fr) repeat(${tiers.length}, minmax(0,1fr))`;
const differs = (cells: PricingCell[]) => new Set(cells.map(String)).size > 1;
---

<section data-slot="pricing-compare" data-pick={pick} class={className}>
  <SectionHead kicker="Compare" title={compare.title} accent={compare.accent} lede={compare.lede}>
    <label slot="aside" for={id} class="inline-flex cursor-pointer items-center gap-3 text-[0.95rem] text-foreground">
      <Switch id={id} size="sm" padding={1} class="w-8" data-pricing-only />
      Only show differences
    </label>
  </SectionHead>

  <div role="table" aria-label={compare.title} class="mt-10 text-[0.9375rem] md:mt-14" style={`--cols:${cols}`} data-compare-table>
    <div role="rowgroup" class="sticky z-20 -mx-1 bg-background px-1 pt-3 pb-3 shadow-[0_1px_0_var(--border)]" style="top:var(--pricing-top, 0px)">
      <Segmented label="Plan to compare" class="mb-3 w-full md:hidden [&>button]:flex-1" value={String(pick)} options={tiers.map((t, i) => ({ value: String(i), label: t.tab }))} data-compare-plan />
      <div role="row" class="grid grid-cols-[minmax(0,1fr)_minmax(0,1.15fr)] gap-x-2 md:grid-cols-(--cols) md:gap-x-3">
        <div role="columnheader" class="hidden items-end pb-1 font-mono text-[11px] tracking-[0.14em] text-muted-foreground uppercase md:flex">{compare.corner}</div>
        {
          tiers.map((t, i) => (
            <div
              role="columnheader"
              data-colhead={i}
              data-show={i === pick ? "" : undefined}
              class={cn("col-span-2 hidden min-w-0 items-center gap-x-3 rounded-xl p-3 data-show:flex sm:p-3.5 md:col-span-1 md:flex md:flex-col md:items-stretch", t.pick ? "band-orange" : "ring-1 ring-foreground/10")}
            >
              <div class="min-w-0 flex-1 md:flex-none">
                <span class="block truncate text-[0.95rem] font-medium">{t.name}</span>
                <span class="mt-1.5 flex min-w-0 items-baseline gap-2 md:block">
                  <span class="text-2xl leading-none font-medium tracking-[-0.03em] tabular-nums">
                    {t.amount.map((a, m) => <span data-at={String(m)} hidden={m !== mode}>{a}</span>)}
                  </span>
                  <span class="truncate text-xs text-muted-foreground md:mt-1 md:block">
                    {t.short.map((s, m) => <span data-at={String(m)} hidden={m !== mode}>{s}</span>)}
                  </span>
                </span>
              </div>
              <ButtonLink {href} size="sm" variant={t.pick ? "primary" : "outline"} class="shrink-0 md:mt-3 md:w-full">{t.act}</ButtonLink>
            </div>
          ))
        }
      </div>
    </div>

    {
      compare.groups.map((g) => (
        <div role="rowgroup" data-group class="mt-10">
          <div role="row" class="flex items-center gap-2.5 border-b border-foreground/70 pb-3 font-mono text-[11px] tracking-[0.14em] text-foreground uppercase">
            <span role="rowheader" class="flex items-center gap-2.5">
              <span aria-hidden="true" class="size-2 bg-primary" />
              {g.name}
            </span>
          </div>
          {g.rows.map(([label, ...cells]) => (
            <div role="row" data-row data-differs={differs(cells) ? "" : undefined} class="grid grid-cols-[minmax(0,1fr)_minmax(0,1.15fr)] gap-x-2 border-b border-border md:grid-cols-(--cols) md:gap-x-3">
              <span role="rowheader" class="py-3.5 pr-2 leading-snug text-foreground">{label}</span>
              {cells.map((c, i) => (
                <span
                  role="cell"
                  data-col={i}
                  data-show={i === pick ? "" : undefined}
                  data-lit={i === pick ? "" : undefined}
                  class="hidden min-w-0 items-center gap-2 px-3 py-3.5 leading-snug transition-colors duration-150 data-lit:bg-primary/7 data-show:flex sm:px-3.5 md:flex motion-reduce:transition-none"
                >
                  {c === true ? (
                    <>
                      <Check class="size-4 shrink-0 text-primary" />
                      <span class="sr-only">Included</span>
                    </>
                  ) : c === false ? (
                    <>
                      <Minus class="size-4 shrink-0 text-foreground/30" />
                      <span class="sr-only">Not included</span>
                    </>
                  ) : (
                    <span class="text-foreground">{c}</span>
                  )}
                </span>
              ))}
            </div>
          ))}
        </div>
      ))
    }
    <p class="mt-6 text-sm text-muted-foreground">{compare.foot}</p>
  </div>
</section>

<script>
  import "./pricing-mode";

  const lit = (root: HTMLElement, col: number) => {
    for (const cell of root.querySelectorAll<HTMLElement>("[data-col]")) cell.toggleAttribute("data-lit", Number(cell.dataset.col) === col);
  };

  document.addEventListener("pointerover", (event) => {
    const table = event.target instanceof HTMLElement ? event.target.closest<HTMLElement>("[data-compare-table]") : null;
    if (!table) return;
    const cell = (event.target as HTMLElement).closest<HTMLElement>("[data-col]");
    lit(table, cell ? Number(cell.dataset.col) : Number(table.closest<HTMLElement>("[data-slot='pricing-compare']")?.dataset.pick ?? 0));
  });

  document.addEventListener(
    "pointerout",
    (event) => {
      const table = event.target instanceof HTMLElement ? event.target.closest<HTMLElement>("[data-compare-table]") : null;
      if (!table || (event.relatedTarget instanceof Node && table.contains(event.relatedTarget))) return;
      lit(table, Number(table.closest<HTMLElement>("[data-slot='pricing-compare']")?.dataset.pick ?? 0));
    },
    true,
  );

  document.addEventListener("segmented-change", (event) => {
    const group = event.target instanceof HTMLElement ? event.target : null;
    if (!group?.hasAttribute("data-compare-plan")) return;
    const root = group.closest<HTMLElement>("[data-slot='pricing-compare']");
    if (!root) return;
    const value = (event as CustomEvent<{ value: string }>).detail.value;
    for (const el of root.querySelectorAll<HTMLElement>("[data-col], [data-colhead]")) el.toggleAttribute("data-show", (el.dataset.col ?? el.dataset.colhead) === value);
  });

  document.addEventListener("click", (event) => {
    const toggle = event.target instanceof HTMLElement ? event.target.closest<HTMLElement>("[data-pricing-only]") : null;
    const root = toggle?.closest<HTMLElement>("[data-slot='pricing-compare']");
    if (!toggle || !root) return;
    const only = toggle.getAttribute("aria-checked") === "true";
    for (const row of root.querySelectorAll<HTMLElement>("[data-row]")) row.hidden = only && !row.hasAttribute("data-differs");
    for (const group of root.querySelectorAll<HTMLElement>("[data-group]")) group.hidden = !group.querySelector("[data-row]:not([hidden])");
  });
</script>
