---
import type { HTMLAttributes } from "astro/types";

import { alertTitle } from "./variants";

// A div, not Starwind's h5: the title's weight is carried by classes, and
// an h5 broke heading order wherever a Notice sat under h2/h3 headings.
type Props = HTMLAttributes<"div">;

const { class: className, ...rest } = Astro.props;
---

<div data-sw-alert-title class={alertTitle({ class: className })} {...rest} data-slot="alert-title">
  <slot />
</div>
