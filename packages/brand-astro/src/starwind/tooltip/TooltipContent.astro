---
import TooltipPrimitive from "@starwind-ui/astro/tooltip";
import type { HTMLAttributes } from "astro/types";
import { tooltipCaret, tooltipContent, tooltipPositioner } from "./variants";

type Props = Omit<HTMLAttributes<"div">, "tabindex" | "tabIndex"> & {
  side?: "top" | "right" | "bottom" | "left";
  align?: "start" | "center" | "end";
  sideOffset?: number;
  avoidCollisions?: boolean;
  positionerClass?: string;
  portalContainer?: string;
  disablePortal?: boolean;
};

const {
  class: className,
  positionerClass,
  side = "top",
  align = "center",
  sideOffset = 8,
  avoidCollisions = true,
  portalContainer,
  disablePortal = false,
  ...rest
} = Astro.props;
---

<TooltipPrimitive.Portal
  container={portalContainer}
  disabled={disablePortal}
  data-slot="tooltip-portal"
>
  <TooltipPrimitive.Positioner
    side={side}
    align={align}
    sideOffset={sideOffset}
    avoidCollisions={avoidCollisions}
    class={tooltipPositioner({ class: positionerClass })}
    data-slot="tooltip-positioner"
  >
    <TooltipPrimitive.Popup
      class={tooltipContent({ class: className })}
      side={side}
      align={align}
      sideOffset={sideOffset}
      avoidCollisions={avoidCollisions}
      {...rest}
      data-slot="tooltip-content"
    >
      <slot>My tooltip!</slot>

      <TooltipPrimitive.Arrow class={tooltipCaret()} data-slot="tooltip-arrow">
        <slot name="icon">
          {/* The caret Starwind ships as a Tabler icon, inlined: the brand
              allows no second icon set (BRAND.md section 6). */}
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true">
            <path
              d="M11.293 7.293a1 1 0 0 1 1.32 -.083l.094 .083l6 6l.083 .094l.054 .077l.054 .096l.017 .036l.027 .067l.032 .108l.01 .053l.01 .06l.004 .057l.002 .059l-.002 .059l-.005 .058l-.009 .06l-.01 .052l-.032 .108l-.027 .067l-.07 .132l-.065 .09l-.073 .081l-.094 .083l-.077 .054l-.096 .054l-.036 .017l-.067 .027l-.108 .032l-.053 .01l-.06 .01l-.057 .004l-.059 .002h-12c-.852 0 -1.297 -.986 -.783 -1.623l.076 -.084l6 -6z"
              fill="currentColor"
            ></path>
          </svg>
        </slot>
      </TooltipPrimitive.Arrow>
    </TooltipPrimitive.Popup>
  </TooltipPrimitive.Positioner>
</TooltipPrimitive.Portal>
