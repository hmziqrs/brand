---
import type { HTMLAttributes } from "astro/types";
import { cn, styleText } from "$brand/utils";

/*
 * The ring: the brand's bullet. It marks a status, a note, a list item, or
 * the current item in a list. It takes the text color; give it one with
 * `text-primary`, `text-green`, and so on.
 */

interface Props extends Omit<HTMLAttributes<"i">, "style"> {
  /** Fill the ring for on, open, done or selected. */
  filled?: boolean;
  style?: string | Record<string, string>;
}

const { filled = false, class: className, style, ...rest } = Astro.props;
---

<i
  data-slot="marker"
  aria-hidden="true"
  class={cn("inline-block size-2.25 shrink-0 rounded-full border-[1.75px] border-current", filled && "bg-current", className)}
  style={styleText(style)}
  {...rest}
></i>
