---
import "@hmziq/brand-core/resolve-title.css";
import { cn } from "$brand/utils";
import { titleWords } from "@hmziq/brand-core/motion/resolve-title";

/*
 * A title whose letters resolve in from a blur, from the middle out, when it
 * scrolls into view, then shimmer in oxide one after another; inside a
 * [data-pointer-host] the letters near the cursor glow. resolve-title.css in
 * core holds the look. Still for reduced motion.
 */

interface Props {
  text: string;
  as?: "h1" | "h2" | "p";
  class?: string;
}

const { text, as: Tag = "h1", class: className } = Astro.props;
const words = titleWords(text);
---

<Tag data-slot="resolve-title" aria-label={text} data-wait class={cn(className)}>{words.map((w, wi) => (<>{wi > 0 && " "}<span aria-hidden="true" class="inline-block whitespace-nowrap">{w.map((l) => <span data-ch class="inline-block" style={`--i: ${l.i}; --o: ${l.off}; --d: ${Math.abs(l.off)};`}>{l.c}</span>)}</span></>))}</Tag>

<script>
  import { glowTitle, revealTitle } from "@hmziq/brand-core/motion/resolve-title";

  const titles = new WeakMap<HTMLElement, () => void>();

  function init(root: HTMLElement) {
    const stopReveal = revealTitle(root, () => root.removeAttribute("data-wait"));
    const stopGlow = glowTitle(root);
    titles.set(root, () => {
      stopReveal();
      stopGlow();
    });
  }

  function initAll() {
    for (const root of document.querySelectorAll<HTMLElement>("[data-slot='resolve-title']")) if (!titles.has(root)) init(root);
  }

  initAll();
  document.addEventListener("astro:page-load", initAll);
  document.addEventListener("astro:before-swap", () => {
    for (const root of document.querySelectorAll<HTMLElement>("[data-slot='resolve-title']")) {
      titles.get(root)?.();
      titles.delete(root);
    }
  });
</script>
