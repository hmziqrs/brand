---
import { ArrowUpRight, FileCode } from "@lucide/astro";
import { cn } from "$brand/utils";
import { Button } from "$brand/starwind/button";
import CodeBlock from "./code-block.astro";
import Mark from "./mark.astro";
import ShaderMaterial from "./shader-material.astro";
import Tag from "./tag.astro";
import TerminalBody from "./terminal-body.astro";
import TerminalLine from "./terminal-line.astro";
import TerminalWindow from "./terminal-window.astro";
import type { TerminalLineData } from "./terminal-line";

/*
 * One row per project beside a sticky rail of their Marks: the words, a
 * button and Tags on the left, the project's terminal or code on its
 * material on the right. The rail follows the row in the middle of the
 * screen and scrolls to a row when picked; a row's terminal types itself in
 * the first time it shows, and its material shifts under the cursor. Still
 * for reduced motion.
 */

export type ProjectRow = {
  id: string;
  name: string;
  /** The two letters on its Mark. */
  symbol: string;
  /** The material behind its terminal. */
  preset: string;
  /** A few words after the name, above the title. */
  kicker: string;
  title: string;
  body: string;
  /** Tags at the foot: language, platform, licence. */
  facts: string[];
  panel: { kind: "terminal"; title: string; lines: TerminalLineData[] } | { kind: "code"; title: string; code: string };
};

interface Props {
  projects: ProjectRow[];
  /** Where each row's button goes. */
  href?: string;
  /** The word before a project's name on its button. */
  explore?: string;
  /** The rail's name for screen readers. */
  label?: string;
  class?: string;
}

const { projects, href = "#", explore = "Explore", label = "Projects", class: className } = Astro.props;
---

<div data-slot="project-rows" class={cn("grid min-w-0 gap-6 lg:grid-cols-[14rem_minmax(0,1fr)] lg:gap-10", className)}>
  <nav aria-label={label} class="min-w-0">
    <ul class="flex gap-2 overflow-x-auto pb-1 [scrollbar-width:none] lg:sticky lg:top-24 lg:flex-col lg:gap-1 lg:overflow-visible">
      {
        projects.map((p, i) => (
          <li class="shrink-0">
            <button
              type="button"
              data-project={i}
              aria-current={i === 0 ? "true" : undefined}
              class="group flex w-full items-center gap-3 rounded-xl px-3 py-2 text-left text-[0.95rem] text-muted-foreground ring-1 ring-foreground/10 transition-[color,box-shadow] outline-none hover:text-foreground focus-visible:ring-3 focus-visible:ring-ring/50 lg:ring-0 aria-[current=true]:text-foreground aria-[current=true]:ring-primary/60 lg:aria-[current=true]:bg-transparent lg:aria-[current=true]:ring-1 lg:aria-[current=true]:ring-foreground/15"
            >
              <Mark symbol={p.symbol} size={28} class="opacity-60 transition-opacity group-hover:opacity-100 group-aria-[current=true]:opacity-100" />
              <span class="font-medium">{p.name}</span>
              <span aria-hidden="true" class="ml-auto hidden size-1.5 bg-mark-square lg:group-aria-[current=true]:block"></span>
            </button>
          </li>
        ))
      }
    </ul>
  </nav>

  <div class="flex min-w-0 flex-col gap-4">
    {
      projects.map((p, i) => (
        <article
          data-project-row={i}
          data-active={i === 0 ? "true" : undefined}
          data-seen={i === 0 ? "true" : undefined}
          class="group/row grid min-w-0 overflow-hidden rounded-2xl ring-1 ring-foreground/10 transition-shadow duration-500 data-active:ring-foreground/25 xl:grid-cols-[minmax(0,5fr)_minmax(0,6fr)]"
        >
          <div class="flex flex-col gap-5 p-6 sm:p-8">
            <p class="font-mono text-xs text-muted-foreground">{p.name} · {p.kicker}</p>
            <h3 class="text-3xl leading-[1.06] font-medium tracking-[-0.03em] text-balance sm:text-[2.4rem]">{p.title}</h3>
            <p class="max-w-[46ch] text-lg leading-relaxed text-foreground/85">{p.body}</p>
            <div>
              <Button href={href} variant="outline" size="lg">{`${explore} ${p.name}`}<ArrowUpRight class="lucide" data-icon="inline-end" /></Button>
            </div>
            <ul class="mt-auto flex flex-wrap gap-1.5 pt-4">
              {p.facts.map((f) => (
                <li>
                  <Tag>{f}</Tag>
                </li>
              ))}
            </ul>
          </div>
          <div role="presentation" data-project-stage class="relative isolate flex min-h-[22rem] items-center justify-center overflow-hidden p-6 sm:p-10">
            <span aria-hidden="true" data-project-material class="absolute -inset-[7%] -z-10 transition-transform duration-700 ease-[cubic-bezier(.2,.7,.2,1)]" style="transform: none;">
              <ShaderMaterial preset={p.preset} rendering="image" controls={false} sizes="(min-width: 1280px) 40vw, 100vw" class="absolute inset-0" />
            </span>
            <div class="dark w-full max-w-[34rem] shadow-[0_30px_80px_-20px_color-mix(in_oklab,black_70%,transparent)]">
              {p.panel.kind === "terminal" ? (
                <TerminalWindow title={p.panel.title} class="bg-background/90 backdrop-blur-md">
                  <TerminalBody class="min-h-0">
                    {p.panel.lines.map((line, k) => (
                      <div class="opacity-0 transition-opacity duration-500 group-data-seen/row:opacity-100 motion-reduce:transition-none" style={`transition-delay: ${300 + k * 160}ms;`}>
                        <TerminalLine line={line} />
                      </div>
                    ))}
                  </TerminalBody>
                </TerminalWindow>
              ) : (
                <TerminalWindow title={p.panel.title} class="bg-background/90 backdrop-blur-md">
                  <FileCode slot="icon" class="lucide" />
                  <CodeBlock code={p.panel.code} lang="rust" copy={false} class="rounded-none border-0 bg-transparent [&_pre]:bg-transparent" />
                </TerminalWindow>
              )}
            </div>
          </div>
        </article>
      ))
    }
  </div>
</div>

<script>
  import { reducedMotion } from "@hmziq/brand-core/motion/canvas";

  const mounted = new WeakMap<HTMLElement, () => void>();

  function mount(root: HTMLElement) {
    const still = reducedMotion();
    const rows = [...root.querySelectorAll<HTMLElement>("[data-project-row]")];
    const buttons = [...root.querySelectorAll<HTMLButtonElement>("[data-project]")];
    const activate = (i: number) => {
      buttons.forEach((b, k) => (k === i ? b.setAttribute("aria-current", "true") : b.removeAttribute("aria-current")));
      rows.forEach((r, k) => r.toggleAttribute("data-active", k === i));
    };
    if (still) rows.forEach((r) => r.setAttribute("data-seen", "true"));
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          const i = rows.indexOf(e.target as HTMLElement);
          if (e.isIntersecting && i >= 0) activate(i);
        }
      },
      { rootMargin: "-40% 0px -40% 0px" },
    );
    const show = new IntersectionObserver(
      (entries) => {
        for (const e of entries) if (e.isIntersecting) (e.target as HTMLElement).setAttribute("data-seen", "true");
      },
      { threshold: 0.3 },
    );
    rows.forEach((r) => {
      io.observe(r);
      show.observe(r);
    });
    const pick = (e: Event) => {
      const i = Number((e.currentTarget as HTMLElement).dataset.project);
      activate(i);
      rows[i]?.scrollIntoView({ behavior: still ? "auto" : "smooth", block: "center" });
    };
    buttons.forEach((b) => b.addEventListener("click", pick));
    const move = (e: PointerEvent) => {
      const stage = e.currentTarget as HTMLElement;
      const material = stage.querySelector<HTMLElement>("[data-project-material]");
      if (still || !material) return;
      const r = stage.getBoundingClientRect();
      const px = ((e.clientX - r.left) / r.width - 0.5) * 2;
      const py = ((e.clientY - r.top) / r.height - 0.5) * 2;
      material.style.transform = `translate3d(${(-px * 2.5).toFixed(2)}%, ${(-py * 2.5).toFixed(2)}%, 0) scale(1.04)`;
    };
    const leave = (e: PointerEvent) => {
      const material = (e.currentTarget as HTMLElement).querySelector<HTMLElement>("[data-project-material]");
      if (material) material.style.transform = "none";
    };
    const stages = [...root.querySelectorAll<HTMLElement>("[data-project-stage]")];
    stages.forEach((s) => {
      s.addEventListener("pointermove", move);
      s.addEventListener("pointerleave", leave);
    });
    mounted.set(root, () => {
      io.disconnect();
      show.disconnect();
      buttons.forEach((b) => b.removeEventListener("click", pick));
      stages.forEach((s) => {
        s.removeEventListener("pointermove", move);
        s.removeEventListener("pointerleave", leave);
      });
    });
  }

  function initAll() {
    for (const root of document.querySelectorAll<HTMLElement>("[data-slot='project-rows']")) if (!mounted.has(root)) mount(root);
  }

  initAll();
  document.addEventListener("astro:page-load", initAll);
  document.addEventListener("astro:before-swap", () => {
    for (const root of document.querySelectorAll<HTMLElement>("[data-slot='project-rows']")) {
      mounted.get(root)?.();
      mounted.delete(root);
    }
  });
</script>
