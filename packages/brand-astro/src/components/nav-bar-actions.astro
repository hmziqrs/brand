---
import { Menu } from "@lucide/astro";
import { siGithub } from "simple-icons";
import { cn } from "$brand/utils";
import Sheet from "$brand/starwind/sheet";
import { button } from "$brand/starwind/button/variants";
import ButtonLink from "$brand/blocks/site/button-link.astro";
import Wordmark from "./wordmark.astro";
import BrandIcon from "./brand-icon.astro";
import type { NavLink } from "./nav-bar.astro";

/*
 * NavBar's right side: the extra slot, GitHub, the buttons, and the phone
 * menu sheet holding every link, menu pages with their lines included.
 */

interface Props {
  site: string;
  maker?: string;
  href: string;
  links: NavLink[];
  cta?: { label: string; href: string };
  secondary?: { label: string; href: string };
  github?: string;
  pill?: boolean;
}

const { site, maker, href, links, cta, secondary, github, pill = false } = Astro.props;
const row = "rounded-md px-2 py-2 hover:bg-foreground/8";
---

<div class="ml-auto flex items-center gap-2 md:ml-0">
  <slot name="extra" />
  {
    github && (
      <a href={github} aria-label="GitHub" class="hidden size-9 place-items-center rounded-md text-muted-foreground hover:text-foreground sm:grid">
        <BrandIcon icon={siGithub} class="size-4" />
      </a>
    )
  }
  {secondary && <ButtonLink href={secondary.href} variant="ghost" size="sm" class="hidden sm:inline-flex">{secondary.label}</ButtonLink>}
  {cta && <ButtonLink href={cta.href} size="sm" class={cn("hidden sm:inline-flex", pill && "rounded-full")}>{cta.label}</ButtonLink>}
  <Sheet.Root class="md:hidden">
    <Sheet.Trigger class={button({ variant: "ghost", size: "icon-sm", class: "md:hidden" })} aria-label="Open the menu">
      <Menu class="lucide" aria-hidden="true" />
    </Sheet.Trigger>
    <Sheet.Content side="right" class="gap-0 p-0">
      <Sheet.Header class="border-b p-5">
        <Sheet.Title class="text-left">
          <a href={href} class="flex shrink-0 items-baseline gap-[0.35em] rounded-sm text-lg outline-none focus-visible:ring-3 focus-visible:ring-ring/50">
            <Wordmark name={site} />
            {maker && <span class="hidden text-[0.78em] text-muted-foreground sm:inline">{maker}</span>}
          </a>
        </Sheet.Title>
      </Sheet.Header>
      <nav aria-label="Main" class="flex flex-col gap-5 overflow-y-auto p-5">
        {
          links.map((link) =>
            link.children?.length ? (
              <div class="flex flex-col gap-1">
                <p class="px-2 text-xs font-medium text-muted-foreground">{link.label}</p>
                {link.children.map((child) => (
                  <a href={child.href} data-nav-bar-link class={row}>
                    <span class="block text-sm">{child.label}</span>
                    {child.description && <span class="mt-0.5 block text-xs leading-snug text-muted-foreground">{child.description}</span>}
                  </a>
                ))}
              </div>
            ) : (
              <a href={link.href ?? "#"} data-nav-bar-link aria-current={link.current ? "page" : undefined} class={cn(row, "text-sm aria-[current=page]:text-primary")}>
                {link.label}
              </a>
            ),
          )
        }
        {
          github && (
            <a href={github} class={cn(row, "flex items-center gap-2 text-sm")}>
              <BrandIcon icon={siGithub} class="size-4" />
              GitHub
            </a>
          )
        }
      </nav>
      {
        (cta || secondary) && (
          <div class="mt-auto flex flex-col gap-2 border-t p-5">
            {secondary && <ButtonLink href={secondary.href} variant="outline" class="w-full">{secondary.label}</ButtonLink>}
            {cta && <ButtonLink href={cta.href} class="w-full">{cta.label}</ButtonLink>}
          </div>
        )
      }
    </Sheet.Content>
  </Sheet.Root>
</div>
