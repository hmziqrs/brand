---
import { siGithub, siX } from "simple-icons";
import { family } from "@hmziq/brand-core/family";
import { cn } from "$brand/utils";
import { Button } from "$brand/starwind/button";
import { Input } from "$brand/starwind/input";
import Container from "$brand/blocks/site/container.astro";
import BrandIcon from "./brand-icon.astro";
import Mark from "./mark.astro";
import Wordmark from "./wordmark.astro";

/*
 * A site's footer in three sizes: columns (links, an optional newsletter,
 * the family, the giant signature), simple (one row of links) and minimal
 * (one line), over an optional full-width stage. Slot: stage (a full-width
 * background behind the contents: WashGlow, …; the footer is the
 * [data-pointer-host] it follows).
 */

type Column = { title: string; links: { label: string; href: string }[] };

interface Props {
  site: string;
  tagline?: string;
  variant?: "columns" | "simple" | "minimal";
  columns?: Column[];
  newsletter?: boolean;
  /** The "More from hmziq" row. */
  more?: boolean;
  /** The giant name the footer ends on. */
  signature?: string | false;
  github?: string;
  x?: string;
  legal?: string;
  /** The kit Container width for the contents: default for most sites, wide to line up with a wide NavBar and wide page sections. */
  size?: "default" | "wide";
  class?: string;
}

const {
  site,
  tagline,
  variant = "columns",
  columns = [],
  newsletter = false,
  more = true,
  signature = "hmziq",
  github,
  x,
  legal = "© 2026 hmziq. Free and open source where it says so.",
  size = "default",
  class: className,
} = Astro.props;

const stage = Astro.slots.has("stage");
const others = family.filter((f) => f.name !== site);
const link = "text-muted-foreground transition-colors outline-none hover:text-foreground focus-visible:rounded-sm focus-visible:ring-3 focus-visible:ring-ring/50";
const icon = cn(link, "grid size-8 place-items-center rounded-md");
---

<footer data-slot="site-footer" data-variant={variant} data-pointer-host={stage ? "" : undefined} class={cn("border-t", stage && "relative isolate overflow-hidden", className)}>
  {stage && <div class="absolute inset-0 -z-10"><slot name="stage" /></div>}
  <Container size={size} class="flex flex-col gap-8 py-10">
    {
      variant === "columns" && (
        <>
          <div class="grid gap-10 lg:grid-cols-[minmax(0,1.2fr)_minmax(0,2fr)]">
            <div class="flex flex-col gap-4">
              <Wordmark name={site} class="text-xl" />
              {tagline && <p class="max-w-xs text-sm leading-relaxed text-muted-foreground">{tagline}</p>}
              {
                newsletter && (
                  <form class="flex max-w-sm gap-2" onsubmit="return false">
                    <label for={`${site}-footer-email`} class="sr-only">Email</label>
                    <Input id={`${site}-footer-email`} type="email" placeholder="you@example.com" autocomplete="email" class="h-9 min-w-0 px-2.5 py-1 text-base outline-none md:text-sm" />
                    <Button type="submit" variant="outline">Subscribe</Button>
                  </form>
                )
              }
            </div>
            {
              columns.length > 0 && (
                <div class="grid grid-cols-2 gap-8 sm:grid-cols-3">
                  {columns.map((col) => (
                    <div class="flex flex-col gap-3">
                      <h2 class="text-sm font-medium">{col.title}</h2>
                      <ul class="flex flex-col gap-2 text-sm">
                        {col.links.map((l) => (
                          <li>
                            <a href={l.href} class={link}>{l.label}</a>
                          </li>
                        ))}
                      </ul>
                    </div>
                  ))}
                </div>
              )
            }
          </div>
          {
            more && (
              <div class="flex flex-col gap-4 border-t pt-8">
                <h2 class="text-sm font-medium">More from hmziq</h2>
                <ul class="flex flex-wrap gap-x-6 gap-y-3 text-sm">
                  {others.map((f) => (
                    <li>
                      <a href={f.href} class={cn(link, "inline-flex items-center gap-2")}><Mark symbol={f.symbol} />{f.name}</a>
                    </li>
                  ))}
                </ul>
              </div>
            )
          }
          {
            signature && (
              <div class="@container overflow-hidden border-t pt-10">
                <Wordmark name={signature} class="block pb-[0.2em] leading-[0.74] tracking-[-0.05em]" style={{ fontSize: "33cqw" }} />
              </div>
            )
          }
          <div class="flex flex-wrap items-center justify-between gap-4 text-[0.8125rem] text-muted-foreground">
            <span>{legal}</span>
            <div class="flex items-center gap-1">
              {github && <a href={github} aria-label="GitHub" class={icon}><BrandIcon icon={siGithub} class="size-4" /></a>}
              {x && <a href={x} aria-label="X" class={icon}><BrandIcon icon={siX} class="size-3.5" /></a>}
            </div>
          </div>
        </>
      )
    }
    {
      variant === "simple" && (
        <>
          <div class="flex flex-col gap-6 md:flex-row md:items-center md:justify-between">
            <Wordmark name={site} class="text-lg" />
            <ul class="flex flex-wrap gap-x-6 gap-y-2 text-sm">
              {columns.flatMap((c) => c.links).slice(0, 6).map((l) => (
                <li>
                  <a href={l.href} class={link}>{l.label}</a>
                </li>
              ))}
            </ul>
            <div class="flex items-center gap-1">
              {github && <a href={github} aria-label="GitHub" class={icon}><BrandIcon icon={siGithub} class="size-4" /></a>}
              {x && <a href={x} aria-label="X" class={icon}><BrandIcon icon={siX} class="size-3.5" /></a>}
            </div>
          </div>
          <p class="text-[0.8125rem] text-muted-foreground">{legal}</p>
        </>
      )
    }
    {
      variant === "minimal" && (
        <div class="flex flex-wrap items-center justify-between gap-4 text-[0.8125rem] text-muted-foreground">
          <span class="flex items-center gap-3"><Wordmark name={site} class="text-sm text-foreground" />{legal}</span>
          <div class="flex items-center gap-1">
            {github && <a href={github} aria-label="GitHub" class={icon}><BrandIcon icon={siGithub} class="size-4" /></a>}
            {x && <a href={x} aria-label="X" class={icon}><BrandIcon icon={siX} class="size-3.5" /></a>}
          </div>
        </div>
      )
    }
  </Container>
</footer>
