---
import { cn } from "$brand/utils";
import Table from "$brand/starwind/table";

/*
 * A table of facts: providers, feature flags, templates. Built on the
 * Starwind Table. accent: boxed, with one column in a soft orange wash, for
 * landing and product pages. lines: a strong line under the headings and
 * thin lines between rows, for docs.
 */

interface Props {
  columns: string[];
  rows: string[][];
  variant?: "accent" | "lines";
  /** How many columns from the left hold names: text color, on one line. */
  names?: number;
  /** The column that matters, washed in orange in the accent style. The last one by default. */
  accent?: number;
  class?: string;
}

const { columns, rows, variant = "accent", names = 1, accent: accentColumn, class: className } = Astro.props;

const accent = variant === "accent";
const washed = accentColumn ?? columns.length - 1;
---

<div data-slot="data-table" class={cn(accent && "overflow-hidden rounded-xl border", className)}>
  <Table.Root class="text-[0.84rem]">
    <Table.Header class={cn(!accent && "[&_tr]:border-foreground")}>
      <Table.Row class="hover:bg-transparent">
        {
          columns.map((c, i) => (
            <Table.Head class={cn("h-auto py-2.5 font-medium text-foreground", accent ? "px-4" : "px-3", accent && i === washed && "bg-primary/7 text-primary")}>{c}</Table.Head>
          ))
        }
      </Table.Row>
    </Table.Header>
    <Table.Body>
      {
        rows.map((row) => (
          <Table.Row class="hover:bg-transparent">
            {row.map((cell, i) => (
              <Table.Cell
                class={cn(
                  "py-3 align-top leading-relaxed",
                  accent ? "px-4" : "px-3",
                  accent && i === washed && "bg-primary/7",
                  i < names ? "whitespace-nowrap text-foreground" : "min-w-36 whitespace-normal text-muted-foreground",
                )}
              >
                {cell}
              </Table.Cell>
            ))}
          </Table.Row>
        ))
      }
    </Table.Body>
  </Table.Root>
</div>
