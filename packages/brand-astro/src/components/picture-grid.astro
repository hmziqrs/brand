---
import { cn } from "$brand/utils";
import PictureCard, { type PictureItem } from "./picture-card.astro";

/*
 * Picture cards in a grid of one, two or three columns. With `filter` set,
 * pills above it narrow the cards to one group (each item's `group`),
 * counting what each pill holds, and the cards slide to their new places.
 * A pick bubbles a `picture-filter` event with the group.
 */

interface Props {
  items: PictureItem[];
  /** The link for items without their own. */
  href?: string;
  /** The pills' label for screen readers ("Where it runs"); set it to show the pills. */
  filter?: string;
  /** The pill that shows everything. */
  all?: string;
  class?: string;
}

const { items, href = "#", filter, all = "All", class: className } = Astro.props;
const groups = [all, ...new Set(items.map((p) => p.group).filter((g): g is string => !!g))];
const count = (g: string) => (g === all ? items.length : items.filter((p) => p.group === g).length);
---

<div data-slot="picture-grid" data-all={all} class={cn("flex min-w-0 flex-col gap-8", className)}>
  {
    filter && (
      <div role="radiogroup" aria-label={filter} class="flex flex-wrap gap-1.5">
        {groups.map((g) => (
          <button
            type="button"
            role="radio"
            aria-checked={g === all ? "true" : "false"}
            data-group={g}
            class="group/pill inline-flex h-9 items-center gap-2 rounded-full px-4 text-[14px] text-foreground ring-1 ring-foreground/15 transition-colors outline-none not-aria-checked:hover:ring-foreground/35 focus-visible:ring-3 focus-visible:ring-ring/50 aria-checked:bg-primary aria-checked:text-primary-foreground aria-checked:ring-primary"
          >
            {g}
            <span class="font-mono text-[11px] text-muted-foreground group-aria-checked/pill:text-inherit group-aria-checked/pill:opacity-80">{count(g)}</span>
          </button>
        ))}
      </div>
    )
  }
  <div class="grid gap-x-6 gap-y-14 sm:grid-cols-2 lg:grid-cols-3">
    {
      items.map((p) => (
        <div data-picture-item data-group={p.group} class="flex min-w-0">
          <PictureCard title={p.title} dek={p.dek} meta={p.meta} tag={p.tag} art={p.art} href={p.href ?? href} class="w-full" />
        </div>
      ))
    }
  </div>
</div>

<script>
  import { reducedMotion } from "@hmziq/brand-core/motion/canvas";

  function pick(root: HTMLElement, value: string) {
    const all = root.dataset.all ?? "All";
    for (const b of root.querySelectorAll<HTMLButtonElement>("[role='radio']")) b.setAttribute("aria-checked", String(b.dataset.group === value));
    const items = [...root.querySelectorAll<HTMLElement>("[data-picture-item]")];
    const before = new Map(items.filter((el) => !el.hidden).map((el) => [el, el.getBoundingClientRect()]));
    for (const el of items) el.hidden = !(value === all || el.dataset.group === value);
    root.dispatchEvent(new CustomEvent("picture-filter", { bubbles: true, detail: { value } }));
    if (reducedMotion()) return;
    for (const el of items) {
      const from = before.get(el);
      if (el.hidden || !from) continue;
      const to = el.getBoundingClientRect();
      const dx = from.left - to.left;
      const dy = from.top - to.top;
      if (dx || dy) el.animate([{ transform: `translate(${dx}px, ${dy}px)` }, { transform: "none" }], { duration: 300, easing: "cubic-bezier(0.33, 1, 0.68, 1)" });
    }
  }

  document.addEventListener("click", (e) => {
    const button = (e.target as Element | null)?.closest<HTMLButtonElement>("[data-slot='picture-grid'] [role='radio']");
    const root = button?.closest<HTMLElement>("[data-slot='picture-grid']");
    if (button && root && button.dataset.group) pick(root, button.dataset.group);
  });
</script>
