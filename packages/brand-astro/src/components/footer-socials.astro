---
import { Mail } from "@lucide/astro";
import { siGithub, siRss, siX, siYoutube } from "simple-icons";
import { cn } from "$brand/utils";
import { shareIcons } from "$brand/blocks/content/share-icons";
import BrandIcon from "./brand-icon.astro";

/*
 * Icon links to where a site lives elsewhere. GitHub, X, YouTube, RSS and
 * LinkedIn show their logos; any other label, like Email, shows the mail
 * icon. The label names each link.
 */

interface Props {
  links: { label: string; href: string }[];
  class?: string;
}

const { links, class: className } = Astro.props;

const logos: Record<string, { path: string }> = {
  GitHub: siGithub,
  X: siX,
  YouTube: siYoutube,
  RSS: siRss,
  LinkedIn: { path: shareIcons.linkedin },
};
---

<ul data-slot="footer-socials" aria-label="Elsewhere" class={cn("-mx-2 flex flex-wrap items-center gap-0.5", className)}>
  {
    links.map((l) => (
      <li>
        <a
          href={l.href}
          aria-label={l.label}
          title={l.label}
          class="grid size-9 place-items-center rounded-md text-foreground transition-colors outline-none hover:bg-foreground/6 hover:text-primary focus-visible:ring-3 focus-visible:ring-ring/50 motion-reduce:transition-none"
        >
          {logos[l.label] ? <BrandIcon icon={logos[l.label]} class={l.label === "X" ? "size-3.5" : "size-4"} /> : <Mail class="lucide size-4" />}
        </a>
      </li>
    ))
  }
</ul>
