---
import type { HTMLAttributes } from "astro/types";
import { cn } from "$brand/utils";
import StepNumber from "./step-number.astro";

/*
 * One step of a stepper: its numbered ring, the line down to the next one,
 * and the step's own content. A done step fills its ring with orange and the
 * line below it turns orange too; the look follows the `data-done`
 * attribute, so a page (or a block like InstallSteps) can mark a step done
 * after the page has shipped without re-rendering it.
 */

interface Props extends HTMLAttributes<"li"> {
  n: number;
  done?: boolean;
}

const { n, done = false, class: className, ...rest } = Astro.props;
---

<li
  data-slot="step"
  data-done={done || undefined}
  class={cn(
    "relative grid grid-cols-[2.25rem_minmax(0,1fr)] gap-5 pb-9 before:absolute before:top-[2.6rem] before:bottom-1.5 before:left-[calc(1.125rem-0.5px)] before:w-px before:transition-colors last:pb-0 last:before:hidden",
    "before:bg-border",
    "data-done:before:bg-primary",
    className,
  )}
  {...rest}
>
  <StepNumber n={n} done={done} />
  <div class="flex min-w-0 flex-col gap-3 pt-1.5">
    <slot />
  </div>
</li>
