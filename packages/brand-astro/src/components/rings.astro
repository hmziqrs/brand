---
import type { HTMLAttributes } from "astro/types";
import { cn, mergeStyle } from "$brand/utils";
import { arcs, hash, ringMoves, ringPresets, rng, type RingMotion, type RingPreset } from "@hmziq/brand-core/motion/rings";
import RingCircles from "./ring-circles.astro";
import "@hmziq/brand-core/rings.css";

/*
 * The hero picture: eleven rings coming in from the right edge, one in orange
 * with a dot where it ends. Drawn from the site's name, so it never changes
 * between visits.
 */

interface Props extends Omit<HTMLAttributes<"svg">, "children" | "style"> {
  /** The site's name. The same name always draws the same rings. */
  seed: string;
  /** What the picture shows, for screen readers. */
  label?: string;
  /**
   * A little movement: a preset ("ripple-turn", "turn", …) or your own mix of
   * the orange ring and the gray rings. Still by default, and always still
   * for visitors who ask for reduced motion.
   */
  motion?: RingPreset | RingMotion;
  /** Stops the movement where it is. */
  paused?: boolean;
  /** 1 as designed; 2 takes twice as long, 0.5 half as long. */
  speed?: number;
  style?: string | Record<string, string>;
}

const { seed, label = "Rings like layers of oxide, one of them orange", motion = "still", paused, speed = 1, class: className, style, ...rest } = Astro.props;

const random = rng(hash(seed) + 7);
const accent = 3 + Math.floor(random() * 3);
const list = arcs(random, { cx: 440, cy: 225, radii: Array.from({ length: 11 }, (_, i) => 34 + i * 34), accent, accentGap: 0.52, gap: [0.06, 0.3] });
const center = { "--cx": "440px", "--cy": "225px", "--ring-speed": `${speed}` };
const { moves, css } = ringMoves(typeof motion === "string" ? ringPresets[motion] : motion, list, seed);
---

<svg
  data-slot="rings"
  data-paused={paused || undefined}
  viewBox="0 0 520 440"
  role="img"
  aria-label={label}
  class={cn("h-auto w-full", className)}
  style={mergeStyle(center, style)}
  {...rest}
>
  {css && <style is:inline set:html={css} />}
  <RingCircles list={list} cx={440} cy={225} color="var(--primary)" width={[1.25, 3]} dot={7} moves={moves} />
</svg>
