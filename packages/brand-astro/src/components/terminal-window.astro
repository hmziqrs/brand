---
import { SquareTerminal } from "@lucide/astro";
import { cn } from "$brand/utils";

/*
 * A terminal window. It's always dark, like a real terminal, on light pages
 * too: `dark` switches every token inside it.
 */

interface Props {
  /** The window's title, shown next to the terminal icon. */
  title: string;
  class?: string;
}

const { title, class: className, ...rest } = Astro.props;
---

<div data-slot="terminal" class={cn("dark min-w-0 overflow-hidden rounded-xl border bg-background text-foreground", className)} {...rest}>
  <div class="flex h-10 items-center gap-2 border-b pr-1.5 pl-3.5 text-[0.8125rem] text-muted-foreground [&>svg]:size-4">
    {Astro.slots.has("icon") ? <slot name="icon" /> : <SquareTerminal />}
    <span class="min-w-0 truncate">{Astro.slots.has("title") ? <slot name="title" /> : title}</span>
    {Astro.slots.has("actions") && <span class="ml-auto flex gap-0.5"><slot name="actions" /></span>}
  </div>
  <slot />
</div>
