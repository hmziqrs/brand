{
	"name": "@hmziq/brand-svelte",
	"version": "0.0.1",
	"private": true,
	"description": "The hmziq brand kit for SvelteKit: the brand pieces and the site blocks, on shadcn-svelte. Never published to npm, only its registry is.",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"prepack": "svelte-kit sync && svelte-package && publint",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"storybook": "storybook dev -p 6007",
		"build-storybook": "storybook build",
		"check:a11y": "node scripts/axe.mjs"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"sideEffects": [
		"**/*.css"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		},
		"./styles/kit.css": "./src/lib/styles/kit.css"
	},
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"dependencies": {
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@fontsource-variable/onest": "^5.3.1",
		"@hmziq/brand-core": "workspace:*",
		"@lucide/svelte": "^1.52.0",
		"bits-ui": "^2.18.0",
		"cn": "^0.4.0",
		"mode-watcher": "^1.1.0",
		"shiki": "4.4.3",
		"simple-icons": "16.32.0",
		"svelte-sonner": "^1.2.1",
		"tw-animate-css": "^1.4.0"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.13.0",
		"@internationalized/date": "^3.12.0",
		"@storybook/addon-a11y": "^10.6.0",
		"@storybook/addon-svelte-csf": "^5.1.5",
		"@storybook/addon-themes": "^10.6.0",
		"@storybook/sveltekit": "^10.6.0",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/package": "^2.5.8",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.0",
		"@tanstack/table-core": "^8.21.3",
		"@types/node": "^26.6.3",
		"bits-ui": "^2.18.0",
		"embla-carousel-svelte": "^8.6.0",
		"paneforge": "^1.0.2",
		"publint": "^0.3.21",
		"shadcn-svelte": "^1.7.0",
		"storybook": "^10.6.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.0",
		"typescript": "~6.0.2",
		"vaul-svelte": "1.0.0-next.7",
		"vite": "^8.0.16"
	},
	"keywords": [
		"svelte",
		"sveltekit",
		"design-system",
		"brand"
	]
}
