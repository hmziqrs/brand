{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "lib": ["ES2023", "DOM"],
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./src/*"],
      "next/image": ["./src/lib/next-image.tsx"],
      "@storybook/nextjs-vite": ["./node_modules/@storybook/react-vite/dist/index.d.ts"]
    }
  },
  "include": ["src"],
  // input-otp.stories is left as the shadcn story registry ships it, and its
  // `render={undefined}` can't satisfy input-otp@1.5's `render?: never` union
  // member. Vite and Storybook build it unchanged; only tsc skips it.
  "exclude": ["src/components/ui/input-otp.stories.tsx"]
}
