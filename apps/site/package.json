{
  "name": "brand-site",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "brand.hmziq.rs: the landing page for the hmziq brand, built from the Astro kit. Static output in dist/.",
  "scripts": {
    "dev": "astro dev --port 4323",
    "build": "astro build",
    "preview": "astro preview --port 4323",
    "typecheck": "astro check && bun -e \"fs.rmSync('.astro', { recursive: true, force: true })\"",
    "render:og": "astro build && bun scripts/render-og.ts"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/onest": "^5.3.1",
    "@hmziq/brand-core": "workspace:*",
    "@lucide/astro": "^1.48.0",
    "@tailwindcss/vite": "^4.3.0",
    "astro": "^7.3.5",
    "simple-icons": "16.32.0",
    "tailwindcss": "^4.3.0",
    "three": "^0.184.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "typescript": "~6.0.3"
  }
}
