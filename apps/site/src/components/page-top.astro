---
import Container from "$brand/blocks/site/container.astro";

interface Props {
  title: string;
  lede: string;
}

const { title, lede } = Astro.props;
---

<section class="pt-10 pb-16 md:pt-16 md:pb-24">
  <Container size="wide">
    <h1 class="max-w-[14em] text-[clamp(2.75rem,7vw,6rem)] leading-[0.98] font-medium tracking-[-0.045em] text-balance">{title}</h1>
    <p class="mt-6 max-w-[36rem] text-[clamp(18px,1.7vw,22px)] leading-normal text-pretty">{lede}</p>
  </Container>
</section>
