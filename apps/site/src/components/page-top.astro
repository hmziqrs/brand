---
import Container from "$brand/blocks/site/container.astro";

interface Props {
  title: string;
  lede: string;
}

const { title, lede } = Astro.props;
---

<section class="pt-10 pb-16 md:pt-16 md:pb-24">
  <Container size="wide">
    <h1 class="max-w-[19em] text-[clamp(2rem,4.2vw,3.5rem)] leading-[1.08] font-medium tracking-[-0.03em] text-balance">{title}</h1>
    <p class="mt-6 max-w-[36rem] text-[clamp(18px,1.4vw,20px)] leading-[1.55] text-pretty">{lede}</p>
  </Container>
</section>
