---
import { Sparkles } from "@lucide/astro";

export type SlopSkin = "glow" | "saas" | "bento" | "editorial" | "glass" | "brutal";

interface Props {
  business: string;
  skin: SlopSkin;
}

const { business, skin } = Astro.props;
const mode = skin === "saas" || skin === "editorial" ? "light" : "dark";
const cards = [
  ["🚀", "Lightning fast", "10x"],
  ["🔒", "Secure by default", "99.9%"],
  ["⚡", "Built to scale", "24/7"],
];
const bars = [38, 52, 44, 66, 58, 79, 92];
const sticker = { glow: "✨ Now with AI", saas: "🎉 Series A announced", bento: "● v2.0 is live", editorial: "A new way to work", glass: "✨ Introducing AI", brutal: "NEW!!!" }[skin];
---

<div class="slop" class:list={[mode]} data-skin={skin} aria-hidden="true">
  <div class="slop-bar">
    <span class="slop-logo"><Sparkles /></span>
    <span class="slop-link"></span><span class="slop-link"></span><span class="slop-link"></span>
    <span class="slop-cta">Get started</span>
  </div>
  <div class="slop-hero">
    <span class="slop-pill">{sticker}</span>
    <p class="slop-title">Build the future of <span>{business}</span></p>
    <p class="slop-lede">The all-in-one platform that helps you work smarter, not harder.</p>
    <div class="slop-actions">
      <span class="slop-go">Get started free →</span>
      <span class="slop-demo">Watch demo</span>
    </div>
  </div>
  <div class="slop-chart">
    <span class="slop-stat">+128%</span>
    <div class="slop-bars">{bars.map((h) => <i style={`height:${h}%`}></i>)}</div>
  </div>
  <div class="slop-cards">
    {cards.map(([icon, name, stat]) => <span class="slop-card"><b>{icon}</b><em>{stat}</em>{name}</span>)}
  </div>
</div>

<style>
  .slop {
    --go: var(--foreground);
    --go-ink: var(--background);
    container-type: inline-size;
    position: relative;
    display: flex;
    aspect-ratio: 4 / 3;
    flex-direction: column;
    overflow: hidden;
    border-radius: 0.75rem;
    background: var(--background);
    color: var(--foreground);
    font-family: system-ui, sans-serif;
    user-select: none;
  }
  .slop-bar {
    display: flex;
    flex: none;
    align-items: center;
    gap: 3cqw;
    padding: 2.6cqw 3.6cqw;
  }
  .slop-logo {
    display: grid;
    width: 5cqw;
    height: 5cqw;
    place-items: center;
    border-radius: 1.2cqw;
    background: var(--go);
    color: var(--go-ink);
  }
  .slop-logo :global(svg) {
    width: 3.4cqw;
    height: 3.4cqw;
  }
  .slop-link {
    width: 6cqw;
    height: 0.9cqw;
    border-radius: 1cqw;
    background: color-mix(in oklab, currentColor 30%, transparent);
  }
  .slop-cta {
    margin-left: auto;
    white-space: nowrap;
    border-radius: 9cqw;
    background: var(--go);
    padding: 0.9cqw 2.2cqw;
    color: var(--go-ink);
    font-size: 1.9cqw;
    font-weight: 600;
  }
  .slop-hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 0 4cqw;
    text-align: center;
  }
  .slop-pill {
    border: 0.2cqw solid color-mix(in oklab, currentColor 30%, transparent);
    border-radius: 9cqw;
    padding: 0.6cqw 2cqw;
    font-size: 1.9cqw;
  }
  .slop-title {
    margin-top: 2.2cqw;
    font-size: 5.7cqw;
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.08;
  }
  .slop-lede {
    margin-top: 1.8cqw;
    max-width: 62cqw;
    opacity: 0.72;
    font-size: 2.3cqw;
    line-height: 1.4;
  }
  .slop-actions {
    display: flex;
    gap: 1.6cqw;
    margin-top: 2.6cqw;
    font-size: 2cqw;
    font-weight: 600;
  }
  .slop-go,
  .slop-demo {
    white-space: nowrap;
  }
  .slop-go {
    border-radius: 9cqw;
    background: var(--go);
    padding: 1.1cqw 2.6cqw;
    color: var(--go-ink);
  }
  .slop-demo {
    border: 0.2cqw solid color-mix(in oklab, currentColor 30%, transparent);
    border-radius: 9cqw;
    padding: 1.1cqw 2.6cqw;
  }
  .slop-chart {
    display: none;
  }
  .slop-cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.6cqw;
    margin: 4cqw 4cqw 0;
  }
  .slop-card {
    display: flex;
    flex-direction: column;
    gap: 0.8cqw;
    border: 0.2cqw solid color-mix(in oklab, currentColor 16%, transparent);
    border-radius: 1.6cqw;
    background: color-mix(in oklab, currentColor 7%, transparent);
    padding: 1.8cqw;
    font-size: 2cqw;
  }
  .slop-card b {
    font-size: 3cqw;
    font-weight: 400;
  }
  .slop-card em {
    display: none;
    font-style: normal;
  }

  .slop[data-skin="glow"] {
    --go: linear-gradient(90deg, var(--purple), var(--pink));
    background:
      radial-gradient(70% 55% at 50% 22%, color-mix(in oklab, var(--purple) 55%, transparent), transparent),
      radial-gradient(40% 40% at 85% 75%, color-mix(in oklab, var(--pink) 28%, transparent), transparent),
      var(--background);
  }
  .slop[data-skin="glow"] .slop-title span {
    background: linear-gradient(90deg, var(--purple), var(--pink));
    background-clip: text;
    color: transparent;
  }

  .slop[data-skin="saas"] {
    --go: var(--blue);
    --go-ink: var(--background);
    display: grid;
    grid-template: auto 1fr auto / 1.05fr 1fr;
    background: linear-gradient(180deg, color-mix(in oklab, var(--blue) 12%, var(--background)), var(--background) 70%);
  }
  .slop[data-skin="saas"] .slop-bar {
    grid-column: 1 / -1;
  }
  .slop[data-skin="saas"] .slop-hero {
    align-items: flex-start;
    justify-content: center;
    text-align: left;
  }
  .slop[data-skin="saas"] .slop-title span {
    color: var(--blue);
  }
  .slop[data-skin="saas"] .slop-lede {
    max-width: none;
  }
  .slop[data-skin="saas"] .slop-actions,
  .slop[data-skin="bento"] .slop-actions {
    font-size: 1.6cqw;
  }
  .slop[data-skin="saas"] .slop-chart {
    position: relative;
    display: flex;
    align-self: center;
    height: 34cqw;
    margin-right: 4cqw;
    border-radius: 2cqw;
    background: var(--background);
    padding: 2.4cqw;
    box-shadow: 0 3cqw 7cqw -2cqw color-mix(in oklab, var(--blue) 45%, transparent);
  }
  .slop[data-skin="saas"] .slop-cards {
    grid-column: 1 / -1;
    margin-top: 0;
    margin-bottom: 3cqw;
  }
  .slop[data-skin="saas"] .slop-card {
    background: var(--background);
  }

  .slop[data-skin="bento"] {
    --go: var(--teal);
    --go-ink: var(--background);
    display: grid;
    grid-template: auto 1fr / 1.15fr 1fr;
    background-color: var(--background);
    background-image:
      linear-gradient(color-mix(in oklab, var(--teal) 16%, transparent) 0.2cqw, transparent 0.2cqw),
      linear-gradient(90deg, color-mix(in oklab, var(--teal) 16%, transparent) 0.2cqw, transparent 0.2cqw);
    background-size: 5cqw 5cqw;
    font-family: ui-monospace, monospace;
  }
  .slop[data-skin="bento"] .slop-bar {
    grid-column: 1 / -1;
  }
  .slop[data-skin="bento"] .slop-hero {
    align-items: flex-start;
    grid-row: 2 / 4;
    justify-content: center;
    text-align: left;
  }
  .slop[data-skin="bento"] .slop-title {
    font-size: 5cqw;
    font-weight: 600;
    letter-spacing: -0.05em;
  }
  .slop[data-skin="bento"] .slop-title span {
    color: var(--teal);
    text-shadow: 0 0 2.4cqw var(--teal);
  }
  .slop[data-skin="bento"] .slop-lede {
    max-width: none;
  }
  .slop[data-skin="bento"] .slop-chart {
    display: flex;
    height: 16cqw;
    margin: 0 4cqw 1.6cqw 0;
    border: 0.2cqw solid color-mix(in oklab, var(--teal) 50%, transparent);
    border-radius: 2cqw;
    background: var(--background);
    padding: 1.6cqw;
  }
  .slop[data-skin="bento"] .slop-cards {
    align-self: start;
    margin: 0 4cqw 0 0;
  }
  .slop[data-skin="bento"] .slop-card {
    border-color: color-mix(in oklab, var(--teal) 50%, transparent);
    background: var(--background);
    font-size: 1.5cqw;
  }
  .slop[data-skin="bento"] .slop-card b {
    display: none;
  }
  .slop[data-skin="bento"] .slop-card em {
    display: block;
    color: var(--teal);
    font-size: 3.6cqw;
    font-weight: 600;
  }

  .slop[data-skin="editorial"] {
    --go: var(--orange);
    --go-ink: var(--background);
    background: color-mix(in oklab, var(--yellow) 13%, var(--background));
    font-family: ui-serif, Georgia, serif;
  }
  .slop[data-skin="editorial"] .slop-logo {
    border-radius: 50%;
  }
  .slop[data-skin="editorial"] .slop-hero {
    align-items: flex-start;
    margin-top: 3cqw;
    padding: 0 6cqw;
    text-align: left;
  }
  .slop[data-skin="editorial"] .slop-pill {
    border: 0;
    padding: 0;
    color: var(--orange);
    font-size: 2.3cqw;
    font-style: italic;
  }
  .slop[data-skin="editorial"] .slop-title {
    font-size: 8cqw;
    font-weight: 400;
    line-height: 1;
  }
  .slop[data-skin="editorial"] .slop-title span {
    color: var(--orange);
    font-style: italic;
  }
  .slop[data-skin="editorial"] .slop-lede {
    max-width: 70cqw;
    font-size: 2.6cqw;
  }
  .slop[data-skin="editorial"] .slop-go,
  .slop[data-skin="editorial"] .slop-demo,
  .slop[data-skin="editorial"] .slop-cta {
    border-radius: 0.8cqw;
  }
  .slop[data-skin="editorial"] .slop-cards {
    margin: auto 6cqw 3cqw;
    gap: 3cqw;
  }
  .slop[data-skin="editorial"] .slop-card {
    border: 0;
    border-top: 0.2cqw solid currentColor;
    border-radius: 0;
    background: none;
    padding: 1.2cqw 0 0;
    font-size: 2.2cqw;
  }
  .slop[data-skin="editorial"] .slop-card b {
    display: none;
  }

  .slop[data-skin="glass"] {
    background:
      radial-gradient(45% 55% at 12% 25%, var(--blue), transparent),
      radial-gradient(50% 60% at 88% 20%, var(--pink), transparent),
      radial-gradient(55% 55% at 55% 100%, var(--orange), transparent),
      radial-gradient(30% 35% at 90% 85%, var(--purple), transparent),
      var(--background);
  }
  .slop[data-skin="glass"] .slop-hero {
    margin: 1cqw 8cqw 0;
    border: 0.25cqw solid color-mix(in oklab, var(--foreground) 35%, transparent);
    border-radius: 3cqw;
    background: color-mix(in oklab, var(--foreground) 14%, transparent);
    padding: 3cqw 2cqw;
    backdrop-filter: blur(2cqw);
  }
  .slop[data-skin="glass"] .slop-lede {
    opacity: 0.9;
  }
  .slop[data-skin="glass"] .slop-cards {
    margin: 2.4cqw 8cqw 0;
  }
  .slop[data-skin="glass"] .slop-card {
    border-color: color-mix(in oklab, var(--foreground) 35%, transparent);
    background: color-mix(in oklab, var(--foreground) 14%, transparent);
    backdrop-filter: blur(2cqw);
  }

  .slop[data-skin="brutal"] {
    --go: var(--pink);
    --go-ink: var(--background);
    background: var(--yellow);
    color: var(--background);
  }
  .slop[data-skin="brutal"] .slop-bar {
    border-bottom: 0.5cqw solid currentColor;
  }
  .slop[data-skin="brutal"] .slop-logo,
  .slop[data-skin="brutal"] .slop-cta,
  .slop[data-skin="brutal"] .slop-go,
  .slop[data-skin="brutal"] .slop-demo,
  .slop[data-skin="brutal"] .slop-card {
    border: 0.45cqw solid currentColor;
    border-color: var(--background);
    border-radius: 0;
    box-shadow: 0.9cqw 0.9cqw 0 var(--background);
  }
  .slop[data-skin="brutal"] .slop-demo,
  .slop[data-skin="brutal"] .slop-card {
    background: var(--foreground);
    color: var(--background);
  }
  .slop[data-skin="brutal"] .slop-hero {
    margin-top: 3cqw;
  }
  .slop[data-skin="brutal"] .slop-pill {
    position: absolute;
    top: 9.5cqw;
    right: 3cqw;
    border: 0.45cqw solid var(--background);
    border-radius: 0;
    background: var(--teal);
    padding: 1cqw 2cqw;
    font-size: 2.6cqw;
    font-weight: 800;
    transform: rotate(9deg);
  }
  .slop[data-skin="brutal"] .slop-title {
    max-width: 70cqw;
    font-size: 6.4cqw;
    font-weight: 900;
    line-height: 1;
    text-transform: uppercase;
  }
  .slop[data-skin="brutal"] .slop-title span {
    background: var(--background);
    padding: 0 1cqw;
    color: var(--yellow);
  }
  .slop[data-skin="brutal"] .slop-lede {
    opacity: 1;
    font-weight: 600;
  }
  .slop[data-skin="brutal"] .slop-cards {
    margin-top: 3.4cqw;
  }

  .slop-bars {
    display: flex;
    flex: 1;
    align-items: flex-end;
    gap: 1.2cqw;
  }
  .slop-bars i {
    flex: 1;
    border-radius: 0.6cqw 0.6cqw 0 0;
    background: var(--go);
  }
  .slop-stat {
    position: absolute;
    top: 2cqw;
    left: 2.4cqw;
    color: var(--go);
    font-size: 3.4cqw;
    font-weight: 800;
  }
  .slop[data-skin="bento"] .slop-stat {
    display: none;
  }
</style>
