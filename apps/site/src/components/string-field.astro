---
interface Props {
  /** Pixels between strings. */
  gap?: number;
  /** Where the strings fade out to leave room for words: a patch in the middle, or the left side. */
  clear?: "center" | "left";
  class?: string;
}

const { gap = 22, clear = "center", class: className } = Astro.props;
---

<div data-slot="string-field" data-clear={clear} aria-hidden="true" class:list={["string-field pointer-events-none absolute inset-0 overflow-hidden", className]}>
  <canvas data-strings={JSON.stringify({ gap })} class="absolute inset-0 h-full w-full"></canvas>
</div>

<style>
  .string-field {
    mask-image: radial-gradient(ellipse 27rem 11rem at 50% 50%, transparent 52%, black 100%), linear-gradient(to bottom, black 80%, transparent 100%);
    mask-composite: intersect;
  }
  .string-field[data-clear="left"] {
    mask-image: linear-gradient(to right, transparent 34%, black 86%), linear-gradient(to bottom, black 80%, transparent 100%);
  }
</style>

<script>
  import { mountStringField } from "../lib/string-field";

  for (const canvas of document.querySelectorAll<HTMLCanvasElement>("[data-slot='string-field'] canvas")) {
    mountStringField(canvas, JSON.parse(canvas.dataset.strings ?? "{}"));
  }
</script>
