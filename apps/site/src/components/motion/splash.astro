---
import Rings from "$brand/components/rings.astro";
import Wordmark from "$brand/components/wordmark.astro";

interface Props {
  layout: "wide" | "tall";
}

const { layout } = Astro.props;
---

<div class="splash dark" data-layout={layout} data-motion role="img" aria-label="The hmziq logo settling in beside its rings">
  <div class="splash-rings"><Rings seed="hmziq" motion="ripple-turn" label="" /></div>
  <div class="splash-words">
    <Wordmark name="hmziq" />
  </div>
</div>

<style>
  .splash {
    --settle: cubic-bezier(0.16, 1, 0.3, 1);
    container-type: inline-size;
    position: relative;
    width: 100%;
    overflow: hidden;
    background: var(--background);
    color: var(--foreground);
  }
  .splash-rings {
    position: absolute;
    animation: splash-in 0.8s var(--settle) both;
  }
  .splash-rings :global(svg) {
    overflow: visible;
  }
  .splash-words {
    position: absolute;
    animation: splash-rise 1s var(--settle) 0.6s both;
  }

  .splash[data-layout="wide"] {
    --rest: translateY(-50%);
    aspect-ratio: 16 / 9;
  }
  .splash[data-layout="wide"] .splash-rings {
    top: 50%;
    right: -4%;
    width: 62%;
    translate: 0 -50%;
  }
  .splash[data-layout="wide"] .splash-words {
    top: 50%;
    left: 8%;
    font-size: 8.33cqw;
  }

  .splash[data-layout="tall"] {
    --rest: translateY(0);
    aspect-ratio: 9 / 16;
  }
  .splash[data-layout="tall"] .splash-words {
    animation-duration: 0.5s;
    animation-delay: 0.3s;
  }
  .splash[data-layout="tall"] .splash-rings {
    inset: 0 0 auto;
    height: 62%;
    overflow: hidden;
    mask-image: radial-gradient(circle at 62cqw 64.5cqw, black var(--splash-reach), transparent calc(var(--splash-reach) + 12cqw)), linear-gradient(black 70%, transparent);
    mask-composite: intersect;
    animation: splash-open 0.9s cubic-bezier(0.3, 0, 0.5, 1) both;
  }
  .splash[data-layout="tall"] .splash-rings :global(svg) {
    position: absolute;
    top: 16cqw;
    right: 20.8%;
    width: 112%;
  }
  .splash[data-layout="tall"] .splash-words {
    bottom: 18%;
    left: 8%;
    font-size: 17cqw;
  }

  @property --splash-reach {
    syntax: "<length>";
    inherits: false;
    initial-value: 120cqw;
  }
  @keyframes splash-open {
    from {
      --splash-reach: 0px;
    }
    to {
      --splash-reach: 120cqw;
    }
  }
  @keyframes splash-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
  @keyframes splash-rise {
    from {
      opacity: 0;
      transform: var(--rest) translateY(1.46cqw);
    }
    to {
      opacity: 1;
      transform: var(--rest);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .splash-rings,
    .splash-words {
      animation-duration: 0s;
      animation-delay: 0s;
    }
  }
</style>
