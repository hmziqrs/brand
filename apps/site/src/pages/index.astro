---
import { ArrowRight } from "@lucide/astro";
import ButtonLink from "$brand/blocks/site/button-link.astro";
import Container from "$brand/blocks/site/container.astro";
import PiecesWall from "../components/pieces-wall.astro";
import SlopPage from "../components/slop-page.astro";
import Splash from "../components/motion/splash.astro";
import StringField from "../components/string-field.astro";
import Site from "../layouts/Site.astro";
import { links } from "../lib/links";
import roster from "../../../../scripts/pieces.json";
import { cn } from "$brand/utils";

const pieceCount = roster.pieces.filter((p) => p.svelte && p.astro).length;

const businesses = [
  ["invoicing", "glow"],
  ["dog walking", "saas"],
  ["bread", "bento"],
  ["tax law", "editorial"],
  ["plumbing", "glass"],
  ["gardening", "brutal"],
] as const;

const title = "text-[clamp(1.625rem,2.8vw,2.25rem)] leading-[1.12] font-medium tracking-[-0.025em] text-balance";
const prose = "max-w-[40rem] text-[clamp(18px,1.4vw,20px)] leading-[1.6] text-pretty";
---

<Site title="brand by hmziq: a brand identity for my websites, apps, posts and videos" description="One look for everything I make: websites, apps, images, social media posts, changelogs, press releases, blogs and videos. See it, and build your own.">
  <article class="flex flex-col gap-20 pb-24 md:gap-24 md:pb-32">
    <header class="relative -mt-16 flex min-h-svh flex-col pt-16">
      <StringField />
      <Container size="wide" class="relative flex flex-1 flex-col items-center justify-center py-20 text-center">
        <h1 class="text-[clamp(2.5rem,5.5vw,4.5rem)] leading-[1.04] font-medium tracking-[-0.035em] text-balance">No more slop<span class="text-primary">.</span></h1>
        <p class="mt-5 max-w-[34rem] text-[clamp(18px,1.4vw,20px)] leading-[1.55] text-pretty">Learn to make a design identity.<br />Stop getting generic slop from AI.</p>
      </Container>
    </header>

    <section>
      <Container size="wide">
        <h2 class={cn(title, "text-center")}>You must've come across sites like these.</h2>
        <div class="h-8" />
        <div class="mt-8 grid grid-cols-2 gap-2 lg:grid-cols-3 lg:gap-3" role="img" aria-label="Six made-up websites for six different businesses, in different colors and layouts, all saying the same things.">
          {businesses.map(([business, skin]) => <SlopPage business={business} skin={skin} />)}
        </div>
      </Container>
    </section>

    <section>
      <Container size="wide">
        <h2 class={title}>The same look on everything I make.</h2>
        <p class={`${prose} mt-5`}>Websites, images, social media posts, changelogs, press releases, blogs, video intros and outros. They all get the same components and graphics, so if you come across two of them, you'll see the similarities.</p>
        <div class="same-look mt-10 grid items-end gap-4">
          <figure class="min-w-0">
            <img src="/og.png" alt="" width="1200" height="630" loading="lazy" class="h-auto w-full rounded-xl ring-1 ring-foreground/10" />
            <figcaption class="mt-2 text-sm text-muted-foreground">An image for a social media post</figcaption>
          </figure>
          <figure class="min-w-0">
            <div class="overflow-hidden rounded-xl ring-1 ring-foreground/10"><Splash layout="wide" /></div>
            <figcaption class="mt-2 text-sm text-muted-foreground">A video intro</figcaption>
          </figure>
          <figure class="min-w-0">
            <div class="overflow-hidden rounded-xl ring-1 ring-foreground/10"><Splash layout="tall" /></div>
            <figcaption class="mt-2 text-sm text-muted-foreground">A short</figcaption>
          </figure>
        </div>
      </Container>
    </section>

    <section id="pieces" class="scroll-mt-24">
      <Container size="wide">
        <h2 class={title}>It isn't finished.</h2>
        <p class={`${prose} mt-5`}>It's still raw, and none of my sites use it yet. These are some of the {pieceCount} pieces so far, running live.</p>
        <ButtonLink href={links.pieces} variant="outline" class="mt-6">Browse all of them<ArrowRight data-icon="inline-end" /></ButtonLink>
        <div class="mt-10"><PiecesWall /></div>
      </Container>
    </section>
  </article>
</Site>

<style is:global>
  @media (min-width: 640px) {
    .same-look {
      grid-template-columns: 1.9fr 1.78fr 0.56fr;
    }
  }
</style>
