---
import Container from "$brand/blocks/site/container.astro";
import Razorbill from "../../../components/razorbill.astro";
import RingBlocks from "../../../components/ring-blocks.astro";
import Site from "../../../layouts/Site.astro";

const options = [
  { kind: "ring-blocks", name: "Ring blocks", note: "The one in the /variant/ hero now." },
  { kind: "blades", name: "Razor blades", note: "The one you liked, unchanged." },
  { kind: "obsidian", name: "Razor blades · obsidian", note: "The same blades as polished black. Their rounded edges reflect a hard studio light, so the razor lines are reflections sliding across the surface." },
  { kind: "horizon", name: "Razor blades · horizon", note: "The blades lie on a floor that recedes in perspective toward a far light; a razor V travels toward you out of the dark." },
] as const;
---

<Site title="Hero graphics: brand by hmziq" description="Ring blocks next to the razor blades shader.">
  {
    options.map(({ kind, name, note }, i) => (
      <section data-pointer-host class:list={["relative flex flex-col overflow-hidden border-b border-foreground/10", i === 0 && "-mt-16 pt-16", kind !== "ring-blocks" && "dark bg-background text-foreground"]} style="min-height: max(88svh, 46rem)">
        {kind === "ring-blocks" ? <RingBlocks /> : <Razorbill look={kind} />}
        <Container size="wide" class="relative flex flex-1 flex-col justify-center py-20">
          <p class="mb-10 text-sm text-muted-foreground">
            <span class="font-medium text-foreground">{name}</span> · {note}
          </p>
          <h1 class="max-w-[12em] text-[clamp(2.5rem,5.5vw,4.5rem)] leading-[1.04] font-medium tracking-[-0.035em] text-balance">
            Give AI your own look<span class="text-primary">.</span>
          </h1>
          <p class="mt-6 max-w-[32rem] text-[clamp(18px,1.4vw,20px)] leading-[1.55] text-pretty">AI builds the same site for everyone. Give it your own colors, font and parts, and what it makes starts to look like yours.</p>
        </Container>
      </section>
    ))
  }
</Site>
