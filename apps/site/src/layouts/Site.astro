---
import "../styles/app.css";
import BandArcs from "$brand/components/band-arcs.astro";
import NavBar from "$brand/components/nav-bar.astro";
import SiteFooter from "$brand/components/site-footer.astro";
import ButtonLink from "$brand/blocks/site/button-link.astro";
import Container from "$brand/blocks/site/container.astro";
import SiteHead from "$brand/blocks/site/site-head.astro";
import ThemeToggle from "../components/theme-toggle.astro";
import { links } from "../lib/links";

interface Props {
  title: string;
  description: string;
  /** The closing orange band. The 404 page leaves it out. */
  closing?: boolean;
}

const { title, description, closing = true } = Astro.props;
const path = Astro.url.pathname;
const url = new URL(path, Astro.site).href;
const pages = [
  { label: "Recipe", href: "/recipe/" },
  { label: "Rules", href: "/rules/" },
  { label: "Stack", href: "/stack/" },
  { label: "Media", href: "/media/" },
];
const next = [
  { label: "Read the recipe", href: "/recipe/" },
  { label: "Read my rules", href: "/rules/" },
].filter((n) => n.href !== path);
---

<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SiteHead site="hmziq" title={title} description={description} url={url} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <script is:inline>
      (function () {
        try {
          if (localStorage.getItem("theme") === "light") document.documentElement.classList.remove("dark");
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="bg-background text-foreground">
    <NavBar site="hmziq" maker="brand" links={pages.map((p) => ({ ...p, current: path === p.href }))} cta={{ label: "Build your own", href: "/recipe/" }} github={links.github} size="wide" class="fixed inset-x-0 top-0 border-foreground/10 bg-background/70 backdrop-blur-2xl backdrop-saturate-150">
      <ThemeToggle slot="extra" />
    </NavBar>

    <main class="pt-16"><slot /></main>

    {
      closing && (
        <section class="band-orange relative overflow-hidden py-24 md:py-36">
          <BandArcs />
          <Container size="wide" class="relative">
            <h2 class="max-w-[14em] text-4xl leading-[1.02] font-medium tracking-[-0.04em] text-balance md:text-[3.25rem]">Now make yours.</h2>
            <div class="mt-9 flex flex-wrap gap-3">
              {next.map((n, i) => <ButtonLink href={n.href} size="lg" variant={i === 0 ? undefined : "outline"}>{n.label}</ButtonLink>)}
            </div>
          </Container>
        </section>
      )
    }

    <SiteFooter site="hmziq" size="wide" legal="© 2026 hmziq." columns={[{ title: "This site", links: pages }, { title: "The kit", links: [{ label: "Components", href: links.pieces }, { label: "Rules file", href: links.rules }, { label: "Source", href: links.github }] }]} />
  </body>
</html>
